---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`absolute inset-0 z-0 overflow-hidden pointer-events-none ${className}`}>
  {/* The Generative Grid */}
  <div class="absolute inset-0 opacity-[0.03] [mask-image:radial-gradient(ellipse_at_center,black,transparent_80%)]">
    <div class="absolute inset-x-0 h-px w-full bg-gradient-to-r from-transparent via-amber-500 to-transparent top-1/4"></div>
    <div class="absolute inset-x-0 h-px w-full bg-gradient-to-r from-transparent via-amber-500 to-transparent top-2/4"></div>
    <div class="absolute inset-x-0 h-px w-full bg-gradient-to-r from-transparent via-amber-500 to-transparent top-3/4"></div>
    <div class="absolute inset-y-0 w-px h-full bg-gradient-to-b from-transparent via-amber-500 to-transparent left-1/4"></div>
    <div class="absolute inset-y-0 w-px h-full bg-gradient-to-b from-transparent via-amber-500 to-transparent left-2/4"></div>
    <div class="absolute inset-y-0 w-px h-full bg-gradient-to-b from-transparent via-amber-500 to-transparent left-3/4"></div>
  </div>

  {/* Pulsing Neuro-Nodes */}
  <div class="absolute top-1/4 left-1/3 w-2 h-2 bg-amber-500 rounded-full blur-sm animate-pulse"></div>
  <div class="absolute top-2/3 left-1/4 w-1.5 h-1.5 bg-blue-500 rounded-full blur-sm animate-pulse [animation-delay:1s]"></div>
  <div class="absolute top-1/2 right-1/4 w-2.5 h-2.5 bg-amber-600 rounded-full blur-sm animate-pulse [animation-delay:2s]"></div>

  {/* Atmospheric Drifts */}
  <div class="absolute -top-1/4 -right-1/4 w-[80%] h-[80%] bg-amber-600/5 rounded-full blur-[160px] animate-drift"></div>
  <div class="absolute -bottom-1/4 -left-1/4 w-[80%] h-[80%] bg-blue-600/5 rounded-full blur-[160px] animate-drift-slow"></div>
</div>

<style>
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(50px, -30px) scale(1.1); }
  }
  @keyframes drift-slow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-40px, 60px) scale(1.05); }
  }
  .animate-drift { animation: drift 20s ease-inline-out infinite; }
  .animate-drift-slow { animation: drift-slow 25s ease-inline-out infinite; }
</style>
