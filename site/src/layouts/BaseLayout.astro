---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "CMT Systems is an independent clinical technology consultancy and equipment auditor providing unbiased evaluation, space planning, and procurement guidance for cognitive-motor systems." 
} = Astro.props;

const navLinks = [
  { href: '/reviews/', label: 'Equipment' },
  { href: '/compare/', label: 'Comparisons' },
  { href: '/applications/', label: 'Applications' },
  { href: '/game-library/', label: 'Game Library' },
  { href: '/how-it-works/', label: 'The Science' },
  { href: '/photo-fit-review/', label: 'Facility Planning' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"
      media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    <title>{title} | CMT Systems — Cognitive Motor Technology Audits</title>

    <!-- JSON-LD SCHEMA: INDEPENDENT CONSULTANCY & LOCAL BUSINESS -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "CMT Systems",
        "alternateName": "Cognitive Motor Training Systems",
        "url": "https://cognitivemotortraining.com",
        "logo": "https://cognitivemotortraining.com/favicon.svg",
        "telephone": "+1-800-431-7788",
        "description": "Independent clinical technology consultancy, equipment auditor, and facility space planner for institutional cognitive-motor training systems.",
        "areaServed": [
          {
            "@type": "AdministrativeArea",
            "name": "Texas"
          },
          {
            "@type": "Country",
            "name": "United States"
          }
        ],
        "knowsAbout": [
          "Cognitive Motor Training",
          "Dual-Task Cost Measurement",
          "SMARTfit Training Systems",
          "Dynavision D2 Evaluation",
          "Neuro-Rehabilitation Technology",
          "Fall Prevention Equipment"
        ],
        "founder": {
          "@type": "Person",
          "name": "Robert Aguilar",
          "jobTitle": "Lead Technology Auditor & Certified Trainer"
        }
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- TOP UTILITY RIBBON -->
    <div class="utility-ribbon">
      <div class="wrap utility-inner">
        <div class="utility-left">
          <span class="pulse-dot"></span>
          <span><strong>Texas Regional Headquarters</strong> &bull; Independent Clinical Technology Audits &amp; Facility Planning</span>
        </div>
        <div class="utility-right">
          <span class="utility-phone">Direct Desk: <a href="tel:18004317788">1-800-431-7788</a></span>
          <span class="utility-badge">Institutional Advisory</span>
        </div>
      </div>
    </div>

    <!-- MAIN HEADER -->
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand-lockup" href="/">
          <div class="brand-symbol">
            <span class="brand-symbol-core"></span>
          </div>
          <div class="brand-text">
            <span class="brand-title">CMT SYSTEMS</span>
            <span class="brand-sub">CLINICAL TECH AUDITS &amp; CONSULTING</span>
          </div>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul class="nav-list nav-list--desktop">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>

          <details class="nav-disclosure">
            <summary aria-label="Open menu">
              <span class="menu-icon"></span>
              Menu
            </summary>
            <ul class="nav-list nav-list--mobile">
              {navLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
              <li><a class="mobile-cta" href="/photo-fit-review/">Get Photo Fit Review</a></li>
            </ul>
          </details>
        </nav>

        <div class="header-actions">
          <a class="cta-button" href="/photo-fit-review/">Get Photo Fit Review &rarr;</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- INSTITUTIONAL FOOTER -->
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-grid">
          <!-- Col 1: Brand & Identity -->
          <div class="footer-col footer-col--brand">
            <div class="brand-lockup brand-lockup--footer">
              <div class="brand-symbol">
                <span class="brand-symbol-core"></span>
              </div>
              <div class="brand-text">
                <span class="brand-title">CMT SYSTEMS</span>
                <span class="brand-sub">CLINICAL TECH AUDITS &amp; CONSULTING</span>
              </div>
            </div>
            <p class="footer-bio">
              Independent clinical technology consulting, facility space planning, and objective equipment audits for cognitive-motor neurotechnology.
            </p>
            <div class="footer-contact">
              <p><strong>Direct Consultation Desk:</strong> <a href="tel:18004317788">1-800-431-7788</a></p>
              <p><strong>Facility Space Audits:</strong> <a href="/photo-fit-review/">Photo Fit Review</a></p>
              <p><strong>Primary Domain:</strong> cognitivemotortraining.com</p>
              <p><strong>Regional Focus:</strong> Texas (San Antonio, Houston TMC, DFW, Austin) &amp; Nationwide Advisory</p>
            </div>
          </div>

          <!-- Col 2: Equipment & Comparisons -->
          <div class="footer-col">
            <h3 class="footer-heading">Equipment &amp; Comparisons</h3>
            <ul class="footer-links">
              <li><a href="/reviews/">Technology Audits &amp; Scoring</a></li>
              <li><a href="/evaluation-framework/">The 5-Dimension Framework</a></li>
              <li><a href="/systems/">SMARTfit Systems Directory</a></li>
              <li><a href="/compare/">Head-to-Head Comparisons</a></li>
              <li><a href="/compare/">SMARTfit vs. Dynavision D2</a></li>
              <li><a href="/compare/">SMARTfit vs. Dividat Senso</a></li>
              <li><a href="/photo-fit-review/">Request Photo Fit Review</a></li>
            </ul>
          </div>

          <!-- Col 3: Applications -->
          <div class="footer-col">
            <h3 class="footer-heading">Clinical Verticals</h3>
            <ul class="footer-links">
              <li><a href="/applications/rehabilitation/">Physical Therapy &amp; Neuro-Rehab</a></li>
              <li><a href="/applications/healthy-aging/">Senior Living &amp; Fall Prevention</a></li>
              <li><a href="/applications/sports-performance/">Sports Performance &amp; Reaction</a></li>
              <li><a href="/applications/tactical/">Tactical &amp; Military Readiness</a></li>
              <li><a href="/applications/education/">K-12 PE &amp; Special Education</a></li>
            </ul>
          </div>

          <!-- Col 4: Science & Demos -->
          <div class="footer-col">
            <h3 class="footer-heading">Evidence &amp; Demos</h3>
            <ul class="footer-links">
              <li><a href="/how-it-works/">Dual-Task Cost (DTC) Science</a></li>
              <li><a href="/game-library/">SMARTfit Game Library (19 Protocols)</a></li>
              <li><a href="/research/">Peer-Reviewed Study Index</a></li>
              <li><a href="/texas-in-services/">Book Texas On-Site Demo</a></li>
              <li><a href="/about/">About Robert Aguilar</a></li>
              <li><a href="/llms.txt">AI Machine Briefing (llms.txt)</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-compliance">
          <p class="compliance-note">
            <strong>Independent Consultancy &amp; Regulatory Disclaimer:</strong> CMT Systems is an independent clinical technology consultancy and equipment auditor. Equipment evaluated on this website consists of commercial exercise, assessment, and training systems and does not constitute FDA-cleared medical devices. System evaluations and scientific citations refer to published research on dual-task motor-cognitive training and neuroplasticity. Use of equipment does not constitute medical diagnosis, treatment, or guaranteed clinical cure, fall prevention, or insurance reimbursement. Applicable CPT codes (including 97112, 97530, 97110, 97116, 97150, 97129, 97130, 97750, 96125) describe clinician-delivered modalities and assessments provided under the discretion of licensed professionals, and do not constitute a guarantee of third-party reimbursement. Equipment pricing and commercial arrangements are confidential and subject to private consultation.
          </p>
        </div>

        <div class="footer-bottom">
          <p class="copyright">&copy; 2026 Cognitive Motor Training (CMT) Systems. All rights reserved.</p>
          <div class="bottom-links">
            <a href="/privacy/">Privacy Policy</a>
            <span>&bull;</span>
            <a href="/terms/">Terms of Service</a>
            <span>&bull;</span>
            <a href="/photo-fit-review/">Photo Fit Review</a>
          </div>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --color-canvas: #FFFFFF;
        --color-surface-dark: #0A1128;
        --color-surface-card: #101A36;
        --color-surface-elevated: #162244;
        --color-border: rgba(255, 255, 255, 0.08);
        --color-border-hover: rgba(255, 255, 255, 0.18);
        --color-border-accent: rgba(255, 101, 0, 0.3);
        
        --color-accent: #FF6500;
        --color-accent-hover: #FF7A1A;
        --color-accent-glow: rgba(255, 101, 0, 0.25);
        
        --color-cyan: #00D2FF;
        --color-blue: #1C64F2;
        --color-green: #10B981;
        
        --color-text-white: #FFFFFF;
        --color-text-light: #F8FAFC;
        --color-text-muted: #94A3B8;
        --color-text-dim: #64748B;

        --font-display: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .cta-button--secondary {
        background: transparent;
        border: 1px solid var(--color-accent);
        color: var(--color-accent);
      }
      .cta-button--secondary:hover {
        background: rgba(255, 101, 0, 0.1);
        color: var(--color-accent-hover);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background-color: #FFFFFF;
        color: #1E293B;
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .wrap {
        max-width: 78rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* SKIP LINK */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-accent);
        color: #fff;
        padding: 0.75rem 1.25rem;
        z-index: 999;
        font-weight: 700;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      /* UTILITY RIBBON */
      .utility-ribbon {
        background: #040711;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.78rem;
        color: var(--color-text-muted);
        padding: 0.45rem 0;
      }
      .utility-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .utility-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--color-accent);
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px var(--color-accent);
      }
      .utility-right {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .utility-phone a {
        color: var(--color-accent);
        font-weight: 700;
      }
      .utility-badge {
        background: rgba(28, 100, 242, 0.15);
        color: #93C5FD;
        border: 1px solid rgba(28, 100, 242, 0.3);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      /* HEADER */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(4, 7, 17, 0.96);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04), 0 4px 24px rgba(0, 0, 0, 0.4);
        transition: background 0.3s ease;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
        gap: 1rem;
      }

      /* BRAND LOCKUP */
      .brand-lockup {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        flex-shrink: 0;
        text-decoration: none;
      }
      .brand-symbol {
        width: 34px;
        height: 34px;
        border-radius: 7px;
        background: linear-gradient(135deg, #1C64F2 0%, #0A1128 100%);
        border: 1px solid rgba(28, 100, 242, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(28, 100, 242, 0.3), inset 0 1px 0 rgba(255,255,255,0.1);
      }
      .brand-symbol-core {
        width: 12px;
        height: 12px;
        border-radius: 2px;
        background: var(--color-accent);
        box-shadow: 0 0 8px var(--color-accent);
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1;
      }
      .brand-title {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.0rem;
        letter-spacing: 0.04em;
        color: var(--color-text-white);
        line-height: 1.15;
        white-space: nowrap;
      }
      .brand-sub {
        font-size: 0.56rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: rgba(255, 101, 0, 0.85);
        text-transform: uppercase;
        margin-top: 0.1rem;
        white-space: nowrap;
      }

      /* NAV */
      .site-nav {
        display: flex;
        align-items: center;
        flex: 1;
        justify-content: center;
      }
      .nav-list--desktop {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 0;
        align-items: center;
      }
      .nav-list--desktop li a {
        display: block;
        font-size: 0.825rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        color: rgba(248, 250, 252, 0.78);
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        white-space: nowrap;
        transition: color 0.18s ease, background 0.18s ease;
        text-decoration: none;
      }
      .nav-list--desktop li a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
      }

      .nav-disclosure {
        display: none;
      }

      /* CTA BUTTON */
      .header-actions {
        flex-shrink: 0;
      }
      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        background: var(--color-accent);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.825rem;
        letter-spacing: 0.01em;
        padding: 0.575rem 1.1rem;
        border-radius: 6px;
        white-space: nowrap;
        box-shadow: 0 2px 12px rgba(255, 101, 0, 0.35);
        transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
      }
      .cta-button:hover {
        background: var(--color-accent-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 18px rgba(255, 101, 0, 0.45);
      }

      /* FOOTER */
      .site-footer {
        background: #040711;
        border-top: 1px solid var(--color-border);
        padding: 5rem 0 2rem;
        margin-top: 6rem;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
        gap: 3rem;
      }
      .footer-bio {
        color: var(--color-text-muted);
        font-size: 0.88rem;
        margin: 1.25rem 0 1.5rem;
        max-width: 22rem;
      }
      .footer-contact p {
        margin: 0.4rem 0;
        font-size: 0.82rem;
        color: var(--color-text-muted);
      }
      .footer-contact a {
        color: var(--color-accent);
      }
      .footer-heading {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-white);
        margin: 0 0 1.25rem;
      }
      .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .footer-links li {
        margin-bottom: 0.75rem;
      }
      .footer-links a {
        color: var(--color-text-muted);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }
      .footer-links a:hover {
        color: var(--color-accent);
      }

      .footer-divider {
        height: 1px;
        background: var(--color-border);
        margin: 3.5rem 0 2rem;
      }
      .compliance-note {
        font-size: 0.75rem;
        line-height: 1.6;
        color: var(--color-text-dim);
      }
      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
        font-size: 0.8rem;
        color: var(--color-text-dim);
      }
      .bottom-links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .bottom-links a {
        color: var(--color-text-muted);
        transition: color 0.2s;
      }
      .bottom-links a:hover {
        color: var(--color-accent);
      }

      /* MOBILE RESPONSIVE */
      @media (max-width: 960px) {
        .nav-list--desktop, .header-actions {
          display: none;
        }
        .nav-disclosure {
          display: block;
          position: relative;
        }
        .nav-disclosure summary {
          list-style: none;
          cursor: pointer;
          color: var(--color-text-light);
          font-weight: 700;
          font-size: 0.9rem;
          padding: 0.4rem 0.8rem;
          border: 1px solid var(--color-border);
          border-radius: 6px;
        }
        .nav-list--mobile {
          position: absolute;
          right: 0;
          top: calc(100% + 0.5rem);
          background: #0A1128;
          border: 1px solid var(--color-border);
          border-radius: 8px;
          list-style: none;
          margin: 0;
          padding: 1rem;
          width: 16rem;
          box-shadow: 0 12px 30px rgba(0,0,0,0.6);
        }
        .nav-list--mobile li {
          margin-bottom: 0.85rem;
        }
        .mobile-cta {
          display: block;
          text-align: center;
          background: var(--color-accent);
          color: #fff !important;
          padding: 0.6rem;
          border-radius: 6px;
          font-weight: 700;
          margin-top: 0.5rem;
        }
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
      }
    </style>
  </body>
</html>
