---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sectors = [
  {
    id: 'rehab',
    name: 'Physical Therapy & Neuro-Rehab',
    tag: 'Clinical Therapy & Hospital Outpatient',
    icon: '🏥',
    image: '/images/rehab/smartfit-protrainer-occupational-therapy-senior-walker-clinic.jpg',
    imageAlt: 'Elderly woman with walker and gait belt striking SMARTfit ProTrainer portable kiosk during PT session supervised by masked clinician',
    caption: 'Clinical Dual-Task Testing: Portable ProTrainer in PT/OT bay — sub-millisecond DTC latency under CPT 97530',
    decisionMaker: 'Clinic Owners, Rehab Directors, PTs, OTs',
    painPoint: 'Subjective functional progress notes, insurance documentation audit risk, and patient disengagement during repetitive motor drills.',
    solution: 'Objective Dual-Task Cost (DTC) baseline latency data exportable to EMR systems, supporting skilled clinical delivery under CPT 97530 (Therapeutic Activities) and CPT 97112 (Neuromuscular Re-education).',
    recommendedSystems: 'SMARTfit® Mini or ProTrainer (High Impact, Wall-Mounted or Mobile Base)',
    keyMetric: 'Sub-millisecond Dual-Task Cost (DTC) Latency Tracking',
    infographic: '/images/infographics/SMARTfit-Neuro-Physical-Infographic.jpg',
    infographicAlt: 'Neuro-physical dual-task training model linking cognitive processing to motor control',
    guidePdf: '/docs/sector-guides/smartfit-physical-therapy-neuro-rehab-clinical-guide.pdf',
    guideTitle: 'Physical Therapy & Neuro-Rehab Clinical Guide (PDF)'
  },
  {
    id: 'senior',
    name: 'Senior Living & Memory Care',
    tag: 'Active Aging & Memory Support',
    icon: '🏘️',
    image: '/images/rehab/smartfit-mini-active-aging-senior-physical-therapist-clinic.jpg',
    imageAlt: 'Senior woman with physical therapist striking SMARTfit Mini 9-target blue panel in active aging clinic session',
    caption: 'Active Aging & Fall Risk: High resident participation with 1:10 staff-to-resident supervision efficiency',
    decisionMaker: 'Executive Directors, Wellness Directors, Life Enrichment Coordinators',
    painPoint: 'Resident fall incidents, cognitive decline, low participation in traditional exercise classes, and the need for family marketing differentiation.',
    solution: 'Gamified cognitive-motor dual-task training that delivers high resident engagement with 1:10 staff-to-resident supervision efficiency. Scalable from seated memory-care games to standing balance challenges.',
    recommendedSystems: 'SMARTfit® MultiTrainer or Mini with Low-Impact Targets',
    keyMetric: '1:10 Staff Efficiency & Documented Resident Attendance',
    infographic: '/images/infographics/cognitive-decline-over-time-3-small.jpg',
    infographicAlt: 'Cognitive decline timeline curve showing Preclinical, MCI, and Dementia trajectory interventions',
    guidePdf: '/docs/sector-guides/smartfit-senior-living-active-aging-memory-care-guide.pdf',
    guideTitle: 'Senior Living & Active Aging Solutions Guide (PDF)'
  },
  {
    id: 'sports',
    name: 'Sports Performance & Athletics',
    tag: 'Elite S&C, Collegiate & Academy',
    icon: '🏆',
    image: '/images/rehab/smartfit-protrainer-wall-mounted-sports-rehab-medicine-ball-bosu.jpg',
    imageAlt: 'Male athlete standing on BOSU balance trainer pressing medicine ball into wall-mounted SMARTfit ProTrainer targets during sports performance session',
    caption: 'Heavy Kinetic Impact: Engineered for medicine ball, soccer ball, and athletic strikes with real-time cognitive load',
    decisionMaker: 'Head Strength & Conditioning Coaches, Athletic Directors, Sports PTs',
    painPoint: 'Athletic plateau in open-field reaction speed, decision-making failure under physical fatigue, and lack of objective return-to-play baseline data.',
    solution: 'Engineered impact tolerance capable of absorbing high-velocity medicine balls, soccer balls, and athletic strikes while forcing split-second Stroop and Flanker decision-making.',
    recommendedSystems: 'SMARTfit® ProTrainer or Strike Pods',
    keyMetric: 'Decision Latency under Cardiovascular & High-Impact Fatigue',
    infographic: '/images/infographics/Wheel-Sports.png',
    infographicAlt: 'SMARTfit Sports Performance cognitive-motor capability domain wheel',
    guidePdf: '/docs/sector-guides/smartfit-sports-performance-athletic-training-guide.pdf',
    guideTitle: 'Sports Performance Training Guide (PDF)'
  },
  {
    id: 'tactical',
    name: 'Tactical & Military Readiness',
    tag: 'Special Forces, Law Enforcement, Defense',
    icon: '🎯',
    image: '/images/rehab/smartfit-trainer-sports-pt-ot-rehab-athlete-floor-exercise.png',
    imageAlt: 'Athlete in plank position striking low SMARTfit Trainer targets while trainer assists with leg resistance — sports PT rehab drill',
    caption: 'Cognitive Stress Inoculation: Mitigating tunnel vision and conditioning rapid decision responses under physical load',
    decisionMaker: 'Unit Commanders, Human Performance Directors, Tactical S&C',
    painPoint: 'Cognitive tunnel vision under physiological stress, shoot/no-shoot decision latency, and lack of quantifiable cognitive-motor stress conditioning.',
    solution: 'Audited high-stress motor-cognitive conditioning combining intense kinetic exertion with unpredictable visual discrimination to sharpen peripheral awareness.',
    recommendedSystems: 'SMARTfit® ProTrainer with Tactical Alphanumeric Protocols',
    keyMetric: 'Target Discrimination Latency & Inhibitory Control Under Load',
    guidePdf: '/docs/sector-guides/smartfit-tactical-military-readiness-guide.pdf',
    guideTitle: 'Tactical & Military Human Performance Guide (PDF)'
  },
  {
    id: 'education',
    name: 'K-12 PE & Special Education',
    tag: 'Adaptive PE, District Athletics, Special Ed',
    icon: '🏫',
    image: '/images/rehab/smartfit-protrainer-pediatric-rehab-child-cognitive-motor.png',
    imageAlt: 'Young child reaching to touch numbered targets on blue SMARTfit ProTrainer portable panel supervised by clinical instructor',
    caption: 'Inclusive Exergaming: Simultaneous gross-motor coordination, math, spelling, and ADHD focus drills for all ages',
    decisionMaker: 'District PE Directors, Special Education Coordinators, Principals',
    painPoint: 'Sedentary screen habits, low student engagement in standard PE, ADHD focus deficits, and difficulty documenting measurable progress for IEP motor goals.',
    solution: 'Inclusive, high-energy exergaming that engages students of all physical abilities simultaneously while supporting math, spelling, and executive function.',
    recommendedSystems: 'SMARTfit® MultiTrainer (Multi-Station Gym Wall)',
    keyMetric: 'Active Student Heart-Rate Minutes & Measurable IEP Milestones',
    infographic: '/images/infographics/Wheel-K12.png',
    infographicAlt: 'SMARTfit K-12 PE and Special Education development wheel',
    guidePdf: '/docs/sector-guides/smartfit-k12-physical-education-youth-brochure.pdf',
    guideTitle: 'K-12 PE & Special Education Brochure (PDF)'
  },
];
---

<BaseLayout
  title="Clinical & Institutional Technology Applications"
  description="Sector-specific cognitive-motor equipment guidance for Physical Therapy, Senior Living, Sports Performance, Tactical Units, and Schools."
>
  <!-- HERO (BRIGHT, AIRY, SPACIOUS) -->
  <section class="apps-hero">
    <div class="wrap">
      <div class="hero-badge">FACILITY SPECIFIC TECHNOLOGY GUIDANCE</div>
      <h1 class="hero-title">Cognitive-Motor Technology Solutions by Setting</h1>
      <p class="hero-lead">
        A clinical neuro-rehab clinic has vastly different throughput demands, mounting constraints, and documentation needs than a senior living community or high-performance training facility. Explore audited guidance tailored to your operational environment.
      </p>
      <div class="hero-actions">
        <a class="cta-button" href="/photo-fit-review/">Request A Facility Photo Fit Review &rarr;</a>
        <a class="cta-secondary" href="/reviews/">View Equipment Audits &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SECTOR SECTIONS (CRISP WHITE AND LIGHT SLATE) -->
  <section class="apps-content-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">SECTOR-SPECIFIC AUDITS</span>
        <h2 class="section-title">Audited Procurement Recommendations</h2>
        <p class="section-desc">
          We evaluate space dimensions, patient safety, billable workflow, and staff throughput for each institutional vertical.
        </p>
      </div>

      <div class="sectors-stack">
        {sectors.map((sector) => (
          <article class="sector-audit-card" id={sector.id}>
            <div class="sector-card-top">
              <div class="sector-icon-box">{sector.icon}</div>
              <div class="sector-meta">
                <span class="sector-tag-pill">{sector.tag}</span>
                <h2 class="sector-card-title">{sector.name}</h2>
                <span class="sector-dm"><strong>Primary Decision Makers:</strong> {sector.decisionMaker}</span>
              </div>
            </div>

            <div class="sector-card-grid">
              <div class="sector-col">
                <div class="detail-block">
                  <h3 class="detail-label text-orange">Core Facility Challenge &amp; Pain Point</h3>
                  <p class="detail-text">{sector.painPoint}</p>
                </div>
                <div class="detail-block">
                  <h3 class="detail-label text-blue">The CMT Audited Solution</h3>
                  <p class="detail-text">{sector.solution}</p>
                </div>
                {sector.infographic && (
                  <div class="sector-infographic-box">
                    <span class="info-label">Sector Evidence &amp; Model</span>
                    <img 
                      src={sector.infographic} 
                      alt={sector.infographicAlt} 
                      loading="lazy" 
                      class="sector-info-img"
                    />
                  </div>
                )}
              </div>

              <div class="sector-col sector-col--specs">
                <div class="sector-media-box">
                  <figure class="sector-figure">
                    <img 
                      src={sector.image} 
                      alt={sector.imageAlt} 
                      width="420" 
                      height="230" 
                      loading="lazy" 
                      class="sector-img" 
                    />
                    <figcaption class="sector-caption">{sector.caption}</figcaption>
                  </figure>
                </div>

                <div class="specs-box">
                  <div class="spec-row">
                    <span class="spec-label">Recommended Hardware:</span>
                    <span class="spec-value">{sector.recommendedSystems}</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-label">Key Outcome Metric:</span>
                    <span class="spec-value">{sector.keyMetric}</span>
                  </div>
                </div>

                <div class="sector-cta-box">
                  {sector.id === 'rehab' && (
                    <a class="cta-deep-dive w-full" href="/applications/rehabilitation/">
                      Deep Dive: PT, OT &amp; SLP Applications &rarr;
                    </a>
                  )}
                  <a class="cta-button w-full" href="/photo-fit-review/">
                    Audit Space For This Setting &rarr;
                  </a>
                  {sector.guidePdf && (
                    <a 
                      href={sector.guidePdf} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="sector-guide-download"
                      aria-label={`Download official ${sector.name} Clinical Guide PDF`}
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <span>Download {sector.guideTitle || `${sector.name} Guide`} (PDF)</span>
                    </a>
                  )}
                  <p class="sector-cta-sub">Free 24-hour CAD clearance &amp; equipment suitability review</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA STRIP (DARK NAVY ANCHOR) -->
  <section class="apps-cta-strip">
    <div class="wrap text-center">
      <h2>Not Sure Which Configuration Fits Your Budget &amp; Population?</h2>
      <p class="cta-lead">
        Send us photos of your room dimensions and tell us about your patient or athlete volume. Robert Aguilar will personally review your space before you commit.
      </p>
      <a class="cta-button" href="/photo-fit-review/">Get Your Free Photo Fit Review &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO (CRISP WHITE, AIRY, SPACIOUS) */
  .apps-hero {
    padding: 5.5rem 0 4.5rem;
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0284C7;
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 900;
    color: #0c2044;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    max-width: 54rem;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: #475569;
    max-width: 52rem;
    line-height: 1.65;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0c2044;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    background: #F8FAFC;
    border-color: #0c2044;
  }

  /* SECTORS LIST (LIGHT SLATE WITH EXPANSIVE WHITE CARDS) */
  .apps-content-section {
    padding: 5.5rem 0 7rem;
    background: #F8FAFC;
  }

  .section-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
  }

  .text-center {
    text-align: center;
  }

  .section-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #FF6500;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: #0c2044;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .section-desc {
    font-size: 1.05rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  .sectors-stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .sector-audit-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.2s ease;
  }

  .sector-audit-card:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
  }

  .sector-card-top {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #E2E8F0;
  }

  .sector-icon-box {
    font-size: 3rem;
    width: 72px;
    height: 72px;
    background: #F1F5F9;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sector-meta {
    display: flex;
    flex-direction: column;
  }

  .sector-tag-pill {
    font-size: 0.75rem;
    font-weight: 800;
    color: #FF6500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }

  .sector-card-title {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 800;
    color: #0c2044;
    margin: 0 0 0.4rem;
  }

  .sector-dm {
    font-size: 0.92rem;
    color: #64748B;
  }

  .sector-dm strong {
    color: #0c2044;
  }

  .sector-card-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
  }

  .detail-block {
    margin-bottom: 2rem;
  }

  .detail-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
  }

  .text-orange {
    color: #D97706;
  }

  .text-blue {
    color: #0284C7;
  }

  .detail-text {
    font-size: 1rem;
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }

  .sector-infographic-box {
    margin-top: 1.5rem;
    padding: 1.25rem;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
  }
  .info-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0284C7;
    margin-bottom: 0.75rem;
  }
  .sector-info-img {
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    border-radius: 6px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    padding: 0.5rem;
    display: block;
  }

  .sector-media-box {
    margin-bottom: 1.5rem;
    border-radius: 12px;
    overflow: hidden;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .sector-figure {
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .sector-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .sector-audit-card:hover .sector-img {
    transform: scale(1.02);
  }

  .sector-caption {
    font-size: 0.78rem;
    color: #475569;
    padding: 0.65rem 0.9rem;
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
  }

  .specs-box {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .spec-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .spec-row:last-child {
    margin-bottom: 0;
  }

  .spec-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-value {
    font-size: 0.98rem;
    font-weight: 700;
    color: #0c2044;
    line-height: 1.5;
  }

  .sector-cta-box {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .cta-deep-dive {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0c2044;
    background: #EFF6FF;
    border: 1.5px solid #BFDBFE;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-deep-dive:hover {
    background: #DBEAFE;
    border-color: #0284C7;
    color: #0284C7;
  }

  .sector-guide-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0c2044;
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sector-guide-download:hover {
    background: #F1F5F9;
    border-color: #0c2044;
    color: #0c2044;
    transform: translateY(-1px);
  }

  .sector-guide-download svg {
    flex-shrink: 0;
    stroke: #ff5500;
  }

  .sector-cta-sub {
    font-size: 0.8rem;
    color: #94A3B8;
    text-align: center;
    margin-top: 0.25rem;
  }

  .w-full {
    width: 100%;
    text-align: center;
  }

  /* CTA STRIP (DARK BLUE ANCHOR) */
  .apps-cta-strip {
    padding: 5.5rem 0;
    background: #0c2044;
    color: #FFFFFF;
    text-align: center;
  }

  .apps-cta-strip h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 1rem;
  }

  .cta-lead {
    font-size: 1.15rem;
    color: #CBD5E1;
    max-width: 44rem;
    margin: 0 auto 2.25rem;
    line-height: 1.65;
  }

  @media (max-width: 960px) {
    .sector-card-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sector-audit-card {
      padding: 2rem;
    }
  }
</style>
