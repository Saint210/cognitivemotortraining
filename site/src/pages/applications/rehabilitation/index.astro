---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cptCodes = [
  {
    code: '97112',
    procedure: 'Neuromuscular Re-education',
    discipline: 'PT / OT',
    description: 'Movement, balance, coordination, kinesthetic sense, posture, and proprioception. Applies when dual-task protocols challenge the neuromuscular system in an open-skill, unpredictable environment.',
  },
  {
    code: '97530',
    procedure: 'Therapeutic Activities',
    discipline: 'PT / OT',
    description: 'Dynamic functional activities to improve real-world function. Applies when gamified dual-task drills simulate daily-living demands: reaching, weight-shifting, locomotion with concurrent cognition.',
  },
  {
    code: '97110',
    procedure: 'Therapeutic Exercise',
    discipline: 'PT / OT',
    description: 'Strengthening, endurance, range of motion, and flexibility. Applicable when training protocols combine targeted physical exercise output with cognitive-motor engagement.',
  },
  {
    code: '97116',
    procedure: 'Gait Training',
    discipline: 'PT / OT',
    description: 'Ambulation activities including assistive devices, orthotics, and prosthetics. Applicable when cognitive-motor protocols integrate walking, stepping, or locomotion challenges.',
  },
  {
    code: '97150',
    procedure: 'Therapeutic Exercise — Group',
    discipline: 'PT / OT / SLP',
    description: 'Therapeutic group exercises performed by two or more patients simultaneously. Supports supervised group brain health programs in senior living and clinic group programming.',
  },
  {
    code: '97129',
    procedure: 'Therapeutic Interventions — Cognitive Function (First 15 min)',
    discipline: 'SLP / OT',
    description: 'Direct therapeutic intervention to improve cognitive function including attention, memory, reasoning, problem-solving, and executive function. The primary SLP and OT cognitive billing code.',
  },
  {
    code: '97130',
    procedure: 'Therapeutic Interventions — Cognitive Function (Add-on, each 15 min)',
    discipline: 'SLP / OT',
    description: 'Reported in addition to 97129 for each additional 15-minute block of continued cognitive function intervention. Extends direct cognitive therapy session billing.',
  },
  {
    code: '97750',
    procedure: 'Physical Performance Test or Measurement',
    discipline: 'PT / OT',
    description: 'Standardized physical performance testing with written report. Applicable when objective dual-task assessment data (latency, accuracy, Dual-Task Cost) is used to establish or document functional baseline.',
  },
  {
    code: '96125',
    procedure: 'Standardized Cognitive Performance Testing',
    discipline: 'SLP / OT / PT',
    description: 'Standardized cognitive performance testing by physician or qualified health professional, per hour. Applicable when structured cognitive assessment protocols generate normative comparison data and a written interpretation.',
  },
];

const testimonials = [
  {
    quote: 'SMARTfit is a new, exciting, state-of-the-art management tool that we offer at the clinic. We\'ve been using it to work with our patients on mobility, strength, endurance and proprioception while challenging the patient\'s cardiovascular abilities. We use it for sports injuries and orthopedic related issues; our geriatrics with cognitive and balance disorders; our neuro population because it challenges cognition, balance and memory all at the same time. The patients absolutely love it. It\'s engaging and it\'s fun.',
    name: 'Bernadine Thomas, PT, DPT, OCS',
    org: 'Newbury Park Physical Therapy — Owner',
    discipline: 'Physical Therapy'
  },
  {
    quote: 'SMARTfit takes the focus of the player off the mechanics and moves it to the external, forcing the brain to solve two problems at the same time. This solves the big missing part in rehab because we want carryover onto the field. SMARTfit is a great tool to test if this is happening before they return to play.',
    name: 'Dr. Chris Powers, PhD, PT, FACSM',
    org: 'USC — Director, Biokinesiology Program & Co-Director, Biomechanics Research Lab',
    discipline: 'Sports Rehabilitation'
  },
  {
    quote: 'SMARTfit is the only technology that can scale cognitive demand while concurrently executing a wide variety of physical movements and skills. Progressive increments in cognitive demand while concurrently scaling physical demands ensures leveling and prevents overwhelm or boredom. This allows the concept of demand and supply to produce optimum results for neuroplasticity. This applies to new learning, recovery and preventions.',
    name: 'Dr. Mike Studer, DPT',
    org: 'World-renowned expert in dual-task neuroplasticity',
    discipline: 'Neuroplasticity & Dual-Task Research'
  },
  {
    quote: 'SMARTfit has added a dimension to rehab we didn\'t have before — the ability to quantify cognitive-motor performance and progress it systematically. For our neuro and ortho patients, that objective documentation changes the clinical conversation entirely.',
    name: 'Ruth Kurihara, PT',
    org: 'Atlantis Physical Therapy',
    discipline: 'Orthopedic & Neurological Rehab'
  },
  {
    quote: 'For our occupational therapy patients — especially pediatric and hand rehab clients — the ability to layer a cognitive demand on top of a motor task while keeping it engaging and game-like is clinically meaningful. Patients stay in the session. They stay motivated.',
    name: 'Kimberly Koretoff, OTD, OTR/L',
    org: 'Occupational Therapy — Pediatrics',
    discipline: 'Occupational Therapy'
  },
  {
    quote: 'From a concussion and sports medicine standpoint, return-to-play decisions need objective data, not just clinical impression. Equipment that tests dual-task performance under cognitive load while generating latency metrics gives our physicians something concrete.',
    name: 'Elizabeth McQueary',
    org: 'Banner Sports Medicine & Concussion Center',
    discipline: 'Sports Medicine & Concussion'
  },
];

const subverticals = [
  {
    id: 'pediatrics',
    icon: '🧒',
    title: 'Pediatrics',
    tag: 'Developmental & Neurological Conditions',
    description: 'Gamified dual-task activities encourage the high-repetition movements essential for recovery in children with neurological, orthopedic, and developmental conditions. The game-based presentation maintains motivation across extended sessions — a persistent challenge in traditional pediatric therapy.',
    disciplines: ['OT', 'PT', 'Speech-Language Pathology'],
    clinicalFocus: 'Developmental coordination disorder, autism spectrum, TBI, orthopedic pediatrics, ADHD',
    metric: 'Repetition count, target accuracy, session duration',
  },
  {
    id: 'sports-rehab',
    icon: '⚽',
    title: 'Sports Rehabilitation & Return-to-Play',
    tag: 'Orthopaedic & Concussion Recovery',
    description: 'Return-to-play decisions require more than pain resolution. Dual-task assessment under physical load tests whether the brain is ready to process and respond under game-speed conditions. External attentional focus — engaging the player with a cognitive stimulus rather than body mechanics — promotes carryover onto the field.',
    disciplines: ['PT', 'OT', 'Sports Medicine'],
    clinicalFocus: 'ACL recovery, concussion return-to-play, ankle sprain, shoulder rehabilitation',
    metric: 'Dual-Task Cost latency under cardiovascular load, decision accuracy',
  },
  {
    id: 'acute-neuro',
    icon: '🧠',
    title: 'Acute Neurological Rehabilitation',
    tag: 'Stroke, TBI & Neurological Conditions',
    description: 'Open-skill dual-task protocols engage cortical recruitment by requiring real-time motor decisions in unpredictable environments. This is fundamentally different from closed-skill repetitive motor drills. For stroke, TBI, and neurodegenerative presentations, stimulating neural-muscular coupling — the bidirectional brain-muscle-sensory feedback loop — is the core mechanism.',
    disciplines: ['PT', 'OT', 'SLP'],
    clinicalFocus: 'CVA / stroke, TBI, Parkinson\'s, MS, vestibular disorders, gait impairment',
    metric: 'Latency improvement, session-to-session DTC trend, gait stability correlation',
  },
  {
    id: 'chronic-conditions',
    icon: '♻️',
    title: 'Chronic Condition Brain Health Programs',
    tag: 'Cognitive Reserve & Aging',
    description: 'Published literature demonstrates that simultaneous cognitive-motor dual-task training stimulates neuroplasticity, recruits the prefrontal cortex, and strengthens cognitive reserve and gait stability in older adults and individuals managing chronic neurodegenerative symptoms. Gamified programming supports long-term participation — the key variable in sustained brain health intervention.',
    disciplines: ['PT', 'OT', 'SLP'],
    clinicalFocus: 'Mild cognitive impairment (MCI), Parkinson\'s disease, vestibular disorders, fall prevention',
    metric: 'Participation consistency, session attendance, clinician-scored functional ratings',
  },
];
---

<BaseLayout
  title="PT, OT & SLP Rehabilitation Applications | CMT Systems"
  description="Evidence-informed cognitive-motor dual-task technology for Physical Therapy, Occupational Therapy, and Speech-Language Pathology. CPT billing matrix, clinical testimonials, and open-skill neuroscience overview."
>

  <!-- HERO -->
  <section class="rehab-hero">
    <div class="wrap">
      <div class="hero-eyebrow">
        <a href="/applications/" class="breadcrumb-link">Applications</a>
        <span class="breadcrumb-sep">›</span>
        <span>Rehabilitation</span>
      </div>
      <div class="hero-badge">CLINICAL REHABILITATION TECHNOLOGY</div>
      <h1 class="hero-title">Physical Therapy, Occupational Therapy &amp; Speech-Language Pathology Applications</h1>
      <p class="hero-lead">
        Cognitive-motor dual-task training intersects PT, OT, and SLP disciplines — each with distinct documentation requirements, billing pathways, and patient populations. This guide maps how gamified dual-task technology fits into each clinical context.
      </p>
      <div class="hero-actions">
        <a class="cta-button" href="/photo-fit-review/">Request a Facility Photo Fit Review &rarr;</a>
        <a class="cta-secondary" href="/game-library/">Explore the Game Library &rarr;</a>
      </div>
    </div>
  </section>

  <!-- OPEN-SKILL vs. CLOSED-SKILL -->
  <section class="science-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">NEUROPLASTICITY FOUNDATION</span>
        <h2 class="section-title">Open-Skill vs. Closed-Skill Training: Why It Matters Clinically</h2>
        <p class="section-desc">
          Not all motor training produces the same degree of cognitive engagement — or the same neuroplastic adaptation.
        </p>
      </div>

      <div class="skill-compare-grid">
        <div class="skill-card skill-card--closed">
          <div class="skill-icon">🔁</div>
          <h3 class="skill-title">Closed-Skill Training</h3>
          <p class="skill-desc">
            Activities performed in predictable, controlled environments where the stimulus sequence is fixed or repeated. Examples: stationary cycling, seated resistance machines, structured balance drills on a fixed surface.
          </p>
          <div class="skill-outcome">
            <span class="outcome-label">Cognitive Demand:</span>
            <span class="outcome-value outcome-low">Low — Automaticity reduces cortical recruitment over time</span>
          </div>
          <div class="skill-outcome">
            <span class="outcome-label">Neuroplastic Stimulus:</span>
            <span class="outcome-value outcome-low">Diminishing — Plateau common with habituation</span>
          </div>
        </div>

        <div class="skill-card skill-card--open">
          <div class="skill-icon">⚡</div>
          <h3 class="skill-title">Open-Skill Training</h3>
          <p class="skill-desc">
            Activities that require constant environmental adaptation — responding to unpredictable stimuli, suppressing incorrect responses (inhibitory control), and executing motor actions concurrently with cognitive tasks.
          </p>
          <div class="skill-outcome">
            <span class="outcome-label">Cognitive Demand:</span>
            <span class="outcome-value outcome-high">High — Prefrontal cortex actively recruited every trial</span>
          </div>
          <div class="skill-outcome">
            <span class="outcome-label">Neuroplastic Stimulus:</span>
            <span class="outcome-value outcome-high">Sustained — Variable challenge maintains cortical engagement</span>
          </div>
        </div>
      </div>

      <div class="neural-coupling-block">
        <h3 class="coupling-title">Neural-Muscular Coupling</h3>
        <p class="coupling-desc">
          The bidirectional communication pathway where the brain directs muscle movement and sensory feedback simultaneously returns to the brain. Dual-task training strengthens this loop by forcing the nervous system to manage competing cognitive and motor demands in real time — the core mechanism underlying functional neuroplasticity in clinical populations.
        </p>
        <div class="coupling-flow">
          <div class="flow-node">Brain Initiates Motor Command</div>
          <div class="flow-arrow">→</div>
          <div class="flow-node">Muscles Execute Movement</div>
          <div class="flow-arrow">→</div>
          <div class="flow-node">Sensory Feedback Returns</div>
          <div class="flow-arrow">→</div>
          <div class="flow-node flow-node--highlight">Concurrent Cognitive Task Prevents Automaticity</div>
        </div>
        <p class="coupling-note">
          <a href="/research/" class="inline-link">Review the supporting literature →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- DISCIPLINE SUB-VERTICALS -->
  <section class="subverticals-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">CLINICAL APPLICATIONS</span>
        <h2 class="section-title">Application by Clinical Setting &amp; Condition</h2>
        <p class="section-desc">
          Dual-task cognitive-motor equipment serves meaningfully different clinical functions across rehabilitation subspecialties.
        </p>
      </div>

      <div class="subverticals-grid">
        {subverticals.map((sv) => (
          <div class="sv-card" id={sv.id}>
            <div class="sv-header">
              <div class="sv-icon">{sv.icon}</div>
              <div class="sv-meta">
                <span class="sv-tag">{sv.tag}</span>
                <h3 class="sv-title">{sv.title}</h3>
              </div>
            </div>
            <p class="sv-desc">{sv.description}</p>
            <div class="sv-details">
              <div class="sv-detail-row">
                <span class="sv-detail-label">Disciplines:</span>
                <div class="sv-discipline-pills">
                  {sv.disciplines.map(d => <span class="discipline-pill">{d}</span>)}
                </div>
              </div>
              <div class="sv-detail-row">
                <span class="sv-detail-label">Clinical Focus:</span>
                <span class="sv-detail-value">{sv.clinicalFocus}</span>
              </div>
              <div class="sv-detail-row">
                <span class="sv-detail-label">Key Metric:</span>
                <span class="sv-detail-value sv-metric">{sv.metric}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CPT BILLING MATRIX -->
  <section class="cpt-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">BILLING REFERENCE</span>
        <h2 class="section-title">CPT Procedure Code Reference Matrix</h2>
        <p class="section-desc">
          Nine CPT codes are relevant to clinician-delivered cognitive-motor dual-task rehabilitation programs. The applicable code(s) depend on documented clinical intent, the treating discipline, and payer-specific coverage policies.
        </p>
      </div>

      <div class="cpt-disclaimer-box">
        <div class="disclaimer-icon">⚠️</div>
        <div class="disclaimer-text">
          <strong>Billing Compliance Disclaimer:</strong> CPT codes describe clinician-delivered therapeutic procedures and are not a guarantee of reimbursement. Billing eligibility depends entirely on skilled clinician delivery, documented medical necessity, and individual payer policies. CMT Systems does not provide billing advice. Consult your compliance officer, billing specialist, or payer directly before coding any service.
        </div>
      </div>

      <div class="cpt-table-wrapper">
        <table class="cpt-table">
          <thead>
            <tr>
              <th class="col-code">CPT Code</th>
              <th class="col-procedure">Procedure Name</th>
              <th class="col-discipline">Primary Discipline</th>
              <th class="col-desc">Clinical Application Context</th>
            </tr>
          </thead>
          <tbody>
            {cptCodes.map((row, i) => (
              <tr class={i % 2 === 0 ? 'row-even' : 'row-odd'}>
                <td class="cpt-code-cell">
                  <span class="cpt-badge">{row.code}</span>
                </td>
                <td class="cpt-proc-cell">{row.procedure}</td>
                <td class="cpt-disc-cell">
                  <div class="disc-pills">
                    {row.discipline.split(' / ').map(d => (
                      <span class={`disc-pill disc-${d.replace('/', '').trim().toLowerCase()}`}>{d.trim()}</span>
                    ))}
                  </div>
                </td>
                <td class="cpt-desc-cell">{row.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- MOBILE STACKED CPT CARDS (NO SLIDING REQUIRED) -->
      <div class="cpt-mobile-stack">
        {cptCodes.map((row) => (
          <article class="cpt-mobile-card">
            <div class="cpt-card-top">
              <span class="cpt-badge">{row.code}</span>
              <div class="disc-pills">
                {row.discipline.split(' / ').map(d => (
                  <span class={`disc-pill disc-${d.replace('/', '').trim().toLowerCase()}`}>{d.trim()}</span>
                ))}
              </div>
            </div>
            <h3 class="cpt-card-title">{row.procedure}</h3>
            <p class="cpt-card-desc">{row.description}</p>
          </article>
        ))}
      </div>

      <div class="cpt-footer-note">
        <p>
          <strong>Note on 97129 / 97130:</strong> These codes require a qualified health professional (SLP, OT, or physician) to deliver skilled cognitive intervention. Equipment alone does not meet the threshold for billing — documented skilled clinician delivery is required by payers. 
          <a href="/evaluation-framework/" class="inline-link">Learn how to evaluate technology for your clinical workflow →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- CLINICAL TESTIMONIALS -->
  <section class="testimonials-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">CLINICIAN PERSPECTIVES</span>
        <h2 class="section-title">What Clinicians Say About Dual-Task Technology</h2>
        <p class="section-desc">
          The following statements are from documented SMARTfit system adopters — clinicians who have integrated cognitive-motor dual-task equipment into active clinical programs. Quotes are attributed to named individuals and their reported institutional affiliations.
        </p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <blockquote class="testimonial-card">
            <div class="quote-mark">"</div>
            <p class="quote-text">{t.quote}</p>
            <footer class="quote-footer">
              <div class="quote-name">{t.name}</div>
              <div class="quote-org">{t.org}</div>
              <span class="quote-discipline-pill">{t.discipline}</span>
            </footer>
          </blockquote>
        ))}
      </div>

      <div class="testimonial-disclosure">
        <p>
          Testimonials above are sourced from SMARTfit manufacturer-published materials and represent adopter opinions, not independently verified clinical outcomes. CMT Systems does not endorse specific clinical claims made in testimonials.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW CMT EVALUATES FOR YOUR CLINIC -->
  <section class="advisory-section">
    <div class="wrap">
      <div class="advisory-grid">
        <div class="advisory-col">
          <span class="section-badge">ADVISORY PROCESS</span>
          <h2 class="advisory-title">How CMT Systems Evaluates Technology for Your Rehabilitation Setting</h2>
          <p class="advisory-desc">
            Clinical equipment decisions in rehabilitation are consequential. CMT Systems evaluates cognitive-motor technology against five dimensions — not manufacturer marketing.
          </p>
          <ul class="advisory-list">
            <li><strong>Clinical Validity:</strong> Does published literature support the mechanism of action for your patient population?</li>
            <li><strong>Documentation Capability:</strong> Can the system produce objective, exportable data that supports skilled-care documentation?</li>
            <li><strong>Space &amp; Workflow Fit:</strong> Does the hardware configuration match your treatment bay dimensions and patient throughput?</li>
            <li><strong>Discipline Coverage:</strong> Which CPT code pathways does the clinical workflow realistically support?</li>
            <li><strong>Total Cost of Ownership:</strong> Hardware, subscription, training, and long-term upgrade trajectory.</li>
          </ul>
          <div class="advisory-cta-row">
            <a href="/photo-fit-review/" class="cta-button">Request a Photo Fit Review &rarr;</a>
            <a href="/evaluation-framework/" class="cta-secondary">View the Evaluation Framework &rarr;</a>
          </div>
        </div>
        <div class="advisory-col advisory-col--links">
          <div class="resource-links-box">
            <h3 class="resource-links-title">Related Resources</h3>
            <ul class="resource-links-list">
              <li>
                <a href="/game-library/" class="resource-link">
                  <span class="rl-icon">🎮</span>
                  <div class="rl-text">
                    <span class="rl-title">Game Library — 19 Clinical Protocols</span>
                    <span class="rl-desc">Bottom-up reactive and top-down executive protocols with clinical applications</span>
                  </div>
                </a>
              </li>
              <li>
                <a href="/research/" class="resource-link">
                  <span class="rl-icon">🔬</span>
                  <div class="rl-text">
                    <span class="rl-title">The Science of Dual-Task Training</span>
                    <span class="rl-desc">Evidence base, neuroplasticity mechanisms, and research limitations</span>
                  </div>
                </a>
              </li>
              <li>
                <a href="/reviews/" class="resource-link">
                  <span class="rl-icon">📊</span>
                  <div class="rl-text">
                    <span class="rl-title">Technology Audits &amp; Comparisons</span>
                    <span class="rl-desc">Independent hardware scoring: SMARTfit, Dynavision, Dividat, Bioness</span>
                  </div>
                </a>
              </li>
              <li>
                <a href="/compare/" class="resource-link">
                  <span class="rl-icon">⚖️</span>
                  <div class="rl-text">
                    <span class="rl-title">Head-to-Head Comparisons</span>
                    <span class="rl-desc">Clinical differentiation across four competing technology platforms</span>
                  </div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="rehab-cta-strip">
    <div class="wrap text-center">
      <h2>Ready to Evaluate Cognitive-Motor Technology for Your Clinic?</h2>
      <p class="cta-lead">
        CMT Systems offers complimentary facility Photo Fit Reviews for qualified rehabilitation programs. Send photos of your treatment space and describe your patient volume — Robert Aguilar will personally assess which configuration fits your setting.
      </p>
      <div class="cta-actions">
        <a class="cta-button" href="/photo-fit-review/">Get Your Free Photo Fit Review &rarr;</a>
      </div>
      <p class="cta-phone">Or call us directly: <a href="tel:+12106390800" class="phone-link">(210) 639-0800</a></p>
    </div>
  </section>

</BaseLayout>

