---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sciencePillars = [
  {
    num: '01',
    title: 'Dual-Task Cost (DTC) Measurement',
    desc: 'When an individual performs a motor task (like walking or balancing) and a cognitive task (like counting backward or naming objects) simultaneously, performance in one or both tasks typically declines. This deficit is known as Dual-Task Cost. Systems that measure DTC provide objective latency baselines in milliseconds.',
  },
  {
    num: '02',
    title: 'Cognitive-Motor Interference',
    desc: 'In traditional rehabilitation, patients often practice balance on stable surfaces while remaining mentally quiet. However, real-world falls happen when someone is distracted, navigating a crowded room, or processing sudden sensory changes. Dual-task training intentionally introduces cognitive interference to build neural resilience.',
  },
  {
    num: '03',
    title: 'Executive Function & Neuroplasticity',
    desc: 'Simultaneous motor and cognitive exertion recruits prefrontal cortex networks and stimulates brain-derived neurotrophic factor (BDNF). By combining gross-motor kinetics with Stroop interference, N-back working memory, and visual-spatial target acquisition, participants reinforce transferable motor-planning pathways.',
  },
];

const clinicalPrinciples = [
  {
    title: 'Exercise Equipment vs. Medical Devices',
    text: 'SMARTfit and similar platforms are commercial exercise, fitness, and functional training systems. They are not FDA-cleared diagnostic or medical treatment devices.',
  },
  {
    title: 'Separation of Science from Product Marketing',
    text: 'Published academic research validates the broad efficacy of dual-task motor-cognitive training for neuroplasticity. That research must not be conflated with a commercial guarantee that any specific machine cures or reverses clinical disease.',
  },
  {
    title: 'CPT Coding Context (97530 & 97112)',
    text: 'Physical and occupational therapists utilize cognitive-motor equipment to deliver skilled therapeutic activities (CPT 97530) or neuromuscular re-education (CPT 97112). Billing eligibility depends entirely on skilled clinician delivery and documented medical necessity.',
  },
];
---

<BaseLayout
  title="The Science of Cognitive-Motor Dual-Task Training"
  description="Understanding Dual-Task Cost (DTC), motor-cognitive interference, and the neuroplastic principles of combined physical-cognitive training."
>
  <!-- HERO (BRIGHT, AIRY, INSTITUTIONAL) -->
  <section class="science-hero">
    <div class="wrap">
      <div class="hero-badge">CLINICAL &amp; NEUROLOGICAL PRINCIPLES</div>
      <h1 class="hero-title">The Science Behind Cognitive-Motor Dual-Task Training</h1>
      <p class="hero-lead">
        The brain and musculoskeletal system do not operate in silos. In the real world, walking, athletic decision-making, and balance require constant neurological multitasking. Here is how simultaneous cognitive-motor training drives adaptation.
      </p>
      <div class="hero-actions">
        <a class="cta-button" href="/evaluation-framework/">Explore The 5-Dimension Framework &rarr;</a>
        <a class="cta-secondary" href="/photo-fit-review/">Request A Photo Fit Review &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CORE PILLARS (LIGHT SLATE WITH SPACIOUS WHITE CARDS) -->
  <section class="pillars-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">NEUROLOGICAL MECHANISMS</span>
        <h2 class="section-title">The Three Pillars of Dual-Task Training</h2>
        <p class="section-desc">
          How combining executive-function demands with gross kinetic movement produces measurable neurological and functional change.
        </p>
      </div>

      <div class="pillars-grid">
        {sciencePillars.map((p) => (
          <div class="pillar-card">
            <span class="pillar-num">{p.num}</span>
            <h3 class="pillar-title">{p.title}</h3>
            <p class="pillar-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INTERACTIVE DUAL-TASK VISUALIZATIONS -->
  <section class="visuals-section">
    <div class="wrap">
      <div class="visuals-intro text-center">
        <span class="section-badge">COGNITIVE DOMAINS IN MOTION</span>
        <h2 class="section-title">How Dual-Task Stimuli Drive Neuroplasticity</h2>
        <p class="section-desc">
          Unlike static brain games or passive physical exercise, true dual-task training forces the central nervous system to coordinate executive processing and kinetic reaction in milliseconds.
        </p>
      </div>

      <div class="visuals-split-grid">
        <div class="visual-card">
          <div class="visual-media">
            <img 
              src="/images/how-it-works/smartfit-six-pillars-athletic-performance-dual-task.gif" 
              alt="Animated diagram showing SMARTfit Six Pillars of Performance and cognitive motor dual-task domains"
              width="500" 
              height="350" 
              loading="lazy" 
              class="visual-img"
            />
          </div>
          <div class="visual-body">
            <span class="visual-tag">Kinetic &amp; Cognitive Architecture</span>
            <h3 class="visual-heading">The 6 Pillars of Performance &amp; Rehab</h3>
            <p class="visual-text">
              Integrates visual processing, decision speed, fine/gross motor coordination, spatial memory, and cardiovascular demand into a synchronized feedback loop.
            </p>
          </div>
        </div>

        <div class="visual-card">
          <div class="visual-media">
            <img 
              src="/images/how-it-works/smartfit-executive-function-all-ages-cognitive-motor.gif" 
              alt="Animated demonstration of executive function stimulus-response loops across all ages and abilities"
              width="500" 
              height="350" 
              loading="lazy" 
              class="visual-img"
            />
          </div>
          <div class="visual-body">
            <span class="visual-tag">Executive Function Loops</span>
            <h3 class="visual-heading">Working Memory &amp; Inhibitory Control</h3>
            <p class="visual-text">
              Visual triggers challenge Stroop interference, N-back recall, and directional task-switching under cardiovascular load, building neural resilience across all ages.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOFTWARE & GAMIFICATION ARCHITECTURE -->
  <section class="platform-section">
    <div class="wrap">
      <div class="platform-container">
        <div class="platform-content">
          <span class="section-badge">SOFTWARE &amp; CLINICAL TELEMETRY</span>
          <h2 class="section-title">Controller Architecture &amp; Sub-Millisecond DTC Tracking</h2>
          <p class="platform-lead">
            Dual-task assessments require precise timing. SMARTfit wireless and wired target matrices communicate directly with the clinician tablet at sub-millisecond speeds, calculating Dual-Task Cost (DTC) baselines instantly.
          </p>

          <div class="platform-features">
            <div class="p-feat">
              <span class="p-feat-num">01</span>
              <div>
                <h4 class="p-feat-title">Objective Dual-Task Cost (DTC) Baseline</h4>
                <p class="p-feat-text">Quantifies motor-cognitive interference by measuring exact reaction latency differential between single-task baseline and dual-task load.</p>
              </div>
            </div>
            <div class="p-feat">
              <span class="p-feat-num">02</span>
              <div>
                <h4 class="p-feat-title">Pre-Programmed Clinical Batteries</h4>
                <p class="p-feat-text">Access verified dual-task protocols designed for TBI/concussion return-to-play, Parkinson's motor-freezing prevention, and geriatric fall risk.</p>
              </div>
            </div>
            <div class="p-feat">
              <span class="p-feat-num">03</span>
              <div>
                <h4 class="p-feat-title">EMR &amp; Documentation Export</h4>
                <p class="p-feat-text">Generates clean PDF reports documenting progress under CPT 97530 (Therapeutic Activities) and CPT 97112 (Neuromuscular Re-education).</p>
              </div>
            </div>
          </div>
        </div>

        <div class="platform-media">
          <figure class="platform-figure">
            <img 
              src="/images/how-it-works/smartfit-controller-app-software-navigation-architecture.png" 
              alt="SMARTfit controller software app navigation architecture and user interface workflow"
              width="540" 
              height="400" 
              loading="lazy" 
              class="platform-img"
            />
            <figcaption class="platform-caption">SMARTfit App Navigation Architecture: Rapid clinician protocol selection &amp; real-time DTC metric collection</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- CLINICAL PROTOCOL & VIDEO DEMONSTRATION (CLEAN, AIRY, HIGH-READABILITY) -->
  <section class="video-protocol-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">CLINICAL PROTOCOL IN ACTION</span>
        <h2 class="section-title">The 3-Step Dual-Task Cost (DTC) Assessment</h2>
        <p class="section-desc">
          Watch how sub-millisecond reaction times and Dual-Task Cost are evaluated in real time in under 5 minutes:
        </p>
      </div>

      <!-- CENTER-STAGE VIDEO PLAYER -->
      <div class="video-stage">
        <div class="video-embed-wrapper">
          <iframe 
            src="https://www.youtube-nocookie.com/embed/uJT6lhjYhO0" 
            title="SMARTfit Dual Task Cost Testing, Reporting and Programming Clinical Demonstration" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen 
            loading="lazy" 
            class="video-iframe"
          ></iframe>
        </div>
        <p class="video-caption">Demonstrating a 30-second Sit-to-Stand test combined with alphanumeric cognitive target selection.</p>
      </div>

      <!-- 3-STEP HORIZONTAL PROGRESSION -->
      <div class="protocol-grid">
        <div class="protocol-card">
          <div class="protocol-step-num">Step 01</div>
          <h3 class="protocol-step-title">Physical Baseline</h3>
          <span class="protocol-subtitle">e.g., 30s Sit-to-Stand or TUG</span>
          <p class="protocol-text">
            Measures raw gross-motor output without any mental distraction or visual cognitive load.
          </p>
          <div class="protocol-metric-chip">Metric: Repetitions &amp; Cadence</div>
        </div>

        <div class="protocol-card">
          <div class="protocol-step-num">Step 02</div>
          <h3 class="protocol-step-title">Cognitive Baseline</h3>
          <span class="protocol-subtitle">Seated Alphanumeric Targets</span>
          <p class="protocol-text">
            Measures isolated visual processing speed, reaction latency (seconds), and strike accuracy while remaining seated.
          </p>
          <div class="protocol-metric-chip">Metric: Accuracy &amp; Latency (sec)</div>
        </div>

        <div class="protocol-card protocol-card--highlight">
          <div class="protocol-step-num protocol-step-num--highlight">Step 03</div>
          <h3 class="protocol-step-title">Concurrent Dual-Task</h3>
          <span class="protocol-subtitle">Physical + Cognitive Combined</span>
          <p class="protocol-text">
            Executes both tasks simultaneously. Calculates exact <strong>Dual-Task Cost (DTC)</strong>—the quantifiable percentage lost when dividing mental bandwidth.
          </p>
          <div class="protocol-metric-chip protocol-metric-chip--highlight">Metric: % Performance Deficit (DTC)</div>
        </div>
      </div>

      <!-- SUMMARY CALLOUT BAR -->
      <div class="protocol-summary-bar">
        <div class="summary-icon">📊</div>
        <div class="summary-text">
          <strong>Automated Clinical Retest Programming:</strong> Upon test completion, the software automatically prescribes targeted strength or attention protocols to reduce Dual-Task Cost over a 2–4 week retest window, documented for EMR export under <strong>CPT 97530 &amp; 97112</strong>.
        </div>
      </div>
    </div>
  </section>

  <!-- GAMIFICATION VALUE FRAMEWORK -->
  <section class="gamification-section">
    <div class="wrap">
      <div class="gamification-card">
        <div class="gamification-media">
          <img 
            src="/images/how-it-works/smartfit-gamification-dual-task-seven-pillars.jpg" 
            alt="The 7 Pillars of Gamification in cognitive motor training: Learning, Skill, Achievement, User Engagement, Challenge, Goal, and Competition"
            width="460" 
            height="460" 
            loading="lazy" 
            class="gamification-img"
          />
        </div>
        <div class="gamification-body">
          <span class="section-badge">PATIENT ADHERENCE &amp; RETENTION</span>
          <h2 class="section-title">The Value of Gamification in Functional Rehab</h2>
          <p class="gamification-lead">
            Traditional therapy repetitions frequently lead to patient boredom and plateau. Structured gamification introduces clear scoring, progressive challenge levels, and immediate feedback loops that boost session engagement by up to 300%.
          </p>
          <ul class="gamification-list">
            <li><strong>Skill Mastery:</strong> Real-time auditory and visual feedback reinforces correct biomechanical strike technique.</li>
            <li><strong>Intrinsic Motivation:</strong> Dynamic alphanumeric displays turn repetitive gait and balance drills into active challenges.</li>
            <li><strong>Scalable Complexity:</strong> Clinicians instantly scale stimulus speed from seated memory-care participants to elite athletes.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CLINICAL BOUNDARIES (CRISP WHITE SECTION) -->
  <section class="boundaries-section">
    <div class="wrap">
      <div class="boundaries-card">
        <div class="boundaries-header">
          <span class="section-badge">ETHICAL CLINICAL BOUNDARIES</span>
          <h2 class="section-title">Evidence Guardrails: What Science Does &amp; Does Not Prove</h2>
          <p class="boundaries-intro">
            At CMT Systems, we tell institutional buyers what the peer-reviewed research shows—including its strict limitations.
          </p>
        </div>

        <div class="principles-grid">
          {clinicalPrinciples.map((cp) => (
            <div class="principle-item">
              <h3 class="principle-title">{cp.title}</h3>
              <p class="principle-text">{cp.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA STRIP (DARK BLUE ANCHOR) -->
  <section class="science-cta-strip">
    <div class="wrap text-center">
      <h2>Looking to Introduce Objective Dual-Task Testing into Your Facility?</h2>
      <p class="cta-lead">
        We help clinical directors and facility owners evaluate equipment footprint, wall mounting, and clinical workflow before making a capital purchase.
      </p>
      <a class="cta-button" href="/photo-fit-review/">Request A Free Photo Fit Review &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO (CRISP WHITE, CLEAN, SPACIOUS) */
