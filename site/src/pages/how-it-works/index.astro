    display: flex;
    flex-direction: column;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
    border-color: #CBD5E1;
  }

  .pillar-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: #FF6500;
    margin-bottom: 1rem;
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
