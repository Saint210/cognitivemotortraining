---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuroMesh from '../components/NeuroMesh.astro';
import { Image } from 'astro:assets';
import miniProduct from '../assets/images/Mini-Low-Impact-45.png';

const dimensions = [
  {
    num: '01',
    name: 'Cognitive Complexity',
    desc: 'Executive function depth (Stroop, Flanker, Working Memory, N-back, Math) vs. simple light stimulus-response.',
    icon: '🧠',
  },
  {
    num: '02',
    name: 'Stimulus Flexibility',
    desc: 'Variety and customization of sensory triggers across visual, auditory, spatial, and alphanumeric modalities.',
    icon: '⚡',
  },
  {
    num: '03',
    name: 'Response Flexibility',
    desc: 'Diversity of motor response patterns: multi-directional targets, choice discrimination, and unpredictable sequencing.',
    icon: '🎯',
  },
  {
    num: '04',
    name: 'Physical Movement',
    desc: 'Full-body kinetic impact (hands, feet, balls, medicine balls) vs. delicate tap-only panels or seated screens.',
    icon: '🏃',
  },
  {
    num: '05',
    name: 'Performance Data',
    desc: 'Sub-millisecond Dual-Task Cost (DTC) latency tracking, EMR-exportable metrics, and clinical documentation for 97530.',
    icon: '📊',
  },
];

const marketSystems = [
  {
    name: 'SMARTfit®',
    status: 'Top Recommendation',
    category: 'Full-Body Dual-Task System',
    highlight: true,
    image: '/images/products/Mini-Low-Impact-45.png',
    imageAlt: 'SMARTfit Mini Single-Station Cognitive-Motor Kiosk 3D Cutout',
    movement: 'Extensive (Full-body, hands, feet, balls)',
    cognitive: 'Extensive (Stroop, Flanker, Memory, Math)',
    multiUser: 'Up to 10+ simultaneously',
    fda: 'Commercial Equipment',
    bestFit: 'Clinics & facilities needing total-body training',
  },
  {
    name: 'Dynavision D2',
    status: 'Specialized Evaluated System',
    category: 'Visuomotor Diagnostic Board',
    highlight: false,
    image: '/images/competitors/dynavision-d2-light-board.png',
    imageAlt: 'Dynavision D2 light-array visuomotor diagnostic board',
    movement: 'Basic (Upper-extremity reach only)',
    cognitive: 'Moderate (T-scope visual search)',
    multiUser: '1 user at a time',
    fda: 'FDA-Cleared Diagnostic/Therapy',
    bestFit: 'Vision therapy & driver rehabilitation',
  },
  {
    name: 'Dividat Senso',
    status: 'Specialized Evaluated System',
    category: 'Stepping Balance Plate',
    highlight: false,
    image: '/images/competitors/dividat-senso-stepping-platform.jpg',
    imageAlt: 'Dividat Senso force-plate balance stepping platform',
    movement: 'Moderate (Lower-body stepping only)',
    cognitive: 'Moderate (Stepping games & choices)',
    multiUser: '1 user at a time',
    fda: 'Commercial Equipment',
    bestFit: 'Geriatric fall prevention & senior living',
  },
  {
    name: 'Bioness (BITS)',
    status: 'Specialized Evaluated System',
    category: 'Touchscreen Cognitive Panel',
    highlight: false,
    image: '/images/competitors/bioness-bits-touchscreen.jpg',
    imageAlt: 'Bioness BITS standardized occupational therapy touchscreen',
    movement: 'Low (Standing/seated screen taps)',
    cognitive: 'Extensive (Cognitive battery tests)',
    multiUser: '1 user at a time',
    fda: 'FDA-Cleared Diagnostic/Therapy',
    bestFit: 'Occupational therapy & fine-motor testing',
  },
];

const audienceSectors = [
  {
    title: 'Physical Therapy & Neuro-Rehab',
    icon: '🏥',
    image: '/images/rehab/smartfit-protrainer-pt-neuro-rehab-senior-assessment-clinic.jpg',
    imageAlt: 'PT clinician demonstrating SMARTfit ProTrainer target tap to senior female patient during cognitive motor neuro-rehab assessment session',
    desc: 'Objective Dual-Task Cost (DTC) baseline data for stroke, TBI, Parkinson’s, and orthopedic rehabilitation under CPT 97530.',
    link: '/applications/',
    tag: 'Clinical PT/OT',
  },
  {
    title: 'Senior Living & Memory Care',
    icon: '🏘️',
    image: '/images/rehab/smartfit-protrainer-senior-wellness-boxing-partner-training.jpg',
    imageAlt: 'Two seniors in boxing gloves training on wall-mounted SMARTfit ProTrainer cognitive motor system in senior wellness facility',
    desc: 'High-engagement fall risk mitigation and cognitive dual-task programming with 1:10 staff-to-resident efficiency.',
    link: '/applications/',
    tag: 'Geriatric Wellness',
  },
  {
    title: 'Athletics & Sports Performance',
    icon: '🏆',
    image: '/images/rehab/smartfit-protrainer-wall-mounted-sports-rehab-medicine-ball-bosu.jpg',
    imageAlt: 'Male athlete standing on BOSU balance trainer pressing medicine ball into wall-mounted SMARTfit ProTrainer targets during sports performance session',
    desc: 'Heavy ball-impact tolerance, sub-millisecond visual reaction latency, and objective concussion return-to-play metrics.',
    link: '/applications/',
    tag: 'Human Performance',
  },
  {
    title: 'Tactical & Military Readiness',
    icon: '🎯',
    image: '/images/rehab/smartfit-trainer-sports-recovery-return-to-sport-soccer.jpg',
    imageAlt: 'Soccer athlete in high-intensity cognitive motor drill on SMARTfit Trainer � sports performance and tactical readiness training',
    desc: 'High-stress motor-cognitive conditioning to counteract tunnel vision and sharpen shoot/no-shoot decision latency.',
    link: '/applications/',
    tag: 'Tactical / Defense',
  },
  {
    title: 'K-12 PE & Special Education',
    icon: '🏫',
    image: '/images/rehab/smartfit-protrainer-pediatric-rehab-child-cognitive-motor.png',
    imageAlt: 'Young child reaching to touch numbered LED targets on blue SMARTfit ProTrainer portable panel supervised by clinical instructor',
    desc: 'Inclusive active sensory engagement, ADHD focus conditioning, and measurable IEP gross-motor developmental progress.',
    link: '/applications/',
    tag: 'School Districts',
  },
];
---

<BaseLayout 
  title="Cognitive-Motor Equipment Selection & Facility Fit Advisory"
  description="Selecting the right cognitive-motor technology shouldn't be complicated. We evaluate dual-task systems using our 5-Dimension Framework to guide your facility fit, equipment selection, and staff onboarding."
>
  <!-- ========================================================================= -->
  <!-- MODULE 1: THE HERO (DARK NAVY #0c2044)                                    -->
  <!-- ========================================================================= -->
  <section class="hero-module">
    <NeuroMesh />
    
    <div class="wrap hero-container">
      <div class="hero-content">
        <div class="eyebrow-pill">
          <span class="pill-spark">📐</span>
          <span>EQUIPMENT ADVISORY & FACILITY PLANNING</span>
        </div>
        
        <h1 class="hero-headline">
          Selecting the right cognitive–motor technology shouldn't be complicated.
        </h1>
        
        <p class="hero-lead">
          We evaluate dual-task systems using our 5-Dimension Framework—analyzing cognitive depth, physical impact, and spatial requirements—so your facility invests with confidence. Get hands-on guidance on system selection, room clearance, and manufacturer-backed clinical onboarding.
        </p>

        <div class="hero-cta-group">
          <a class="cta-primary" href="/photo-fit-review/">
            Request a Free Photo Fit Review &rarr;
          </a>
          <a class="cta-secondary" href="/evaluation-framework/">
            Explore the 5-Dimension Framework
          </a>
        </div>
      </div>

      <!-- HARDWARE HUD DISPLAY -->
      <div class="hero-visual">
        <div class="hud-card">
          <div class="hud-header">
            <span class="hud-badge-audited">FEATURED SPECIFICATION</span>
            <span class="hud-live-tag">CLINICAL & REHAB</span>
          </div>

          <div class="hud-image-box">
            <Image 
              src={miniProduct}
              alt="SMARTfit Mini Single-Station Cognitive-Motor Kiosk on Rolling Frame"
              width={380}
              height={380}
              format="webp"
              class="hardware-render"
            />
          </div>

          <div class="hud-score-row">
            <div class="score-pill">
              <span class="score-title">5-Dimension Fit</span>
              <span class="score-value">High Kinetic + Dual-Task</span>
            </div>
            <div class="score-pill">
              <span class="score-title">Onboarding</span>
              <span class="score-value score-accent">SMARTfit Direct Training</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 2: THE TRUST STRIP (CRISP WHITE #FFFFFF)                           -->
  <!-- ========================================================================= -->
  <section class="trust-module">
    <div class="wrap">
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon">🔧</div>
          <h3 class="trust-title">Field Installation Insight</h3>
          <p class="trust-desc">Real-world experience assembling hardware, mounting frames, and configuring systems on site.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">📐</div>
          <h3 class="trust-title">Facility Space Planning</h3>
          <p class="trust-desc">We review your wall studs, ceiling clearance, and patient movement zones before you spend a dime.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">⚖️</div>
          <h3 class="trust-title">5-Dimension Evaluation</h3>
          <p class="trust-desc">Objective benchmarks comparing cognitive load, kinetic impact, and data tracking across systems.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">🎓</div>
          <h3 class="trust-title">Turnkey Onboarding</h3>
          <p class="trust-desc">Direct manufacturer-backed clinical training and certification so your team hits the ground running.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 3: THE 5-DIMENSION FRAMEWORK (LIGHT SLATE #F8FAFC / #F1F5F9)       -->
  <!-- ========================================================================= -->
  <section class="framework-module">
    <div class="wrap">
      <div class="module-header text-center">
        <span class="section-eyebrow">EQUIPMENT DECISION BENCHMARKS</span>
        <h2 class="section-headline section-headline--dark">The CMT 5-Dimension Evaluation Framework</h2>
        <p class="section-lead section-lead--dark">
          We evaluate systems across five objective criteria—Cognitive Complexity, Stimulus Flexibility, Response Flexibility, Physical Movement, and Performance Data—to help facilities compare options with clarity.
        </p>
      </div>

      <div class="dimensions-grid">
        {dimensions.map((dim) => (
          <div class="dimension-card">
            <div class="dim-top">
              <span class="dim-icon">{dim.icon}</span>
              <span class="dim-num">{dim.num}</span>
            </div>
            <h3 class="dim-name">{dim.name}</h3>
            <p class="dim-desc">{dim.desc}</p>
          </div>
        ))}
      </div>

      <div class="framework-cta-box text-center">
        <a class="framework-btn" href="/evaluation-framework/">
          Explore the Framework Methodology &rarr;
        </a>
        <a class="framework-btn-sec" href="/resources/evaluation-worksheet.md" download>
          Download Evaluation Worksheet (.md) &darr;
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 3.5: AUDIENCE & SETTING SOLUTIONS                                  -->
  <!-- ========================================================================= -->
  <section class="sectors-module">
    <div class="wrap">
      <div class="module-header text-center">
        <span class="section-eyebrow">EQUIPMENT GUIDANCE BY SETTING</span>
        <h2 class="section-headline section-headline--dark">Which environment are you outfitting?</h2>
        <p class="section-lead section-lead--dark">
          Every facility has distinct throughput constraints, safety requirements, and clinical objectives. Explore our recommended equipment guidance for your specific sector:
        </p>
      </div>

      <div class="sectors-grid">
        {audienceSectors.map((sector) => (
          <a class="sector-card" href={sector.link}>
            <div class="sector-media">
              <img 
                src={sector.image} 
                alt={sector.imageAlt} 
                width="280" 
                height="150" 
                loading="lazy" 
                class="sector-media-img" 
              />
              <span class="sector-tag">{sector.tag}</span>
            </div>
            <div class="sector-body">
              <h3 class="sector-title">{sector.title}</h3>
              <p class="sector-desc">{sector.desc}</p>
              <span class="sector-link">Explore Sector Guidance &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 4: THE MARKET LANDSCAPE (CRISP WHITE #FFFFFF)                      -->
  <!-- ========================================================================= -->
  <section class="landscape-module">
    <div class="wrap">
      <div class="module-header text-center">
        <span class="section-eyebrow">OBJECTIVE SPECIFICATION COMPARISON</span>
        <h2 class="section-headline section-headline--dark">How Top Systems Compare — And Why We Recommend SMARTfit</h2>
        <p class="section-lead section-lead--dark">
          Based on published manufacturer specifications and technical documentation, SMARTfit stands out for facilities seeking high-impact, total-body kinetic dual-task training.
        </p>
      </div>

      <!-- TIER 1 SYSTEMS GRID -->
      <div class="systems-grid">
        {marketSystems.map((sys) => (
          <div class={`system-card ${sys.highlight ? 'system-card--recommended' : ''}`}>
            {sys.highlight && <div class="rec-badge">TOP RECOMMENDATION</div>}
            
            {sys.image && (
              <div class={`sys-media-box ${sys.highlight ? 'sys-media-box--highlight' : ''}`}>
                <img 
                  src={sys.image} 
                  alt={sys.imageAlt || `${sys.name} hardware`} 
                  width="220" 
                  height="140" 
                  loading="lazy" 
                  class="sys-thumb-img"
                />
              </div>
            )}

            <div class="sys-header">
              <h3 class="sys-name">{sys.name}</h3>
              <span class="sys-cat">{sys.category}</span>
            </div>
            
            <ul class="sys-specs-list">
              <li>
                <strong>Physical Movement:</strong> 
                <span>{sys.movement}</span>
              </li>
              <li>
                <strong>Cognitive Depth:</strong> 
                <span>{sys.cognitive}</span>
              </li>
              <li>
                <strong>Multi-User Capacity:</strong> 
                <span>{sys.multiUser}</span>
              </li>
              <li>
                <strong>Regulatory / FDA:</strong> 
                <span>{sys.fda}</span>
              </li>
              <li class="sys-best-fit">
                <strong>Best Fit Setting:</strong> 
                <span>{sys.bestFit}</span>
              </li>
            </ul>

            <div class="sys-footer">
              {sys.highlight ? (
                <div class="sys-actions-stack">
                  <a class="sys-cta-rec" href="/photo-fit-review/">Check Space Fit For SMARTfit &rarr;</a>
                  <a class="sys-cta-audit" href="/reviews/">Read Hardware Review &rarr;</a>
                </div>
              ) : (
                <div class="sys-actions-stack">
                  <a class="sys-cta-comp" href="/compare/">Compare Systems &rarr;</a>
                  <a class="sys-cta-audit" href="/reviews/">Read Specification Review &rarr;</a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- COMMERCIAL DISCLOSURE -->
      <div class="disclosure-box">
        <p>
          <strong>Commercial Transparency Disclosure:</strong> We may receive compensation when you purchase equipment through our referrals. Commercial relationships do not establish clinical superiority. We evaluate all equipment objectively based on physical specs and published literature.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 5: THE PHOTO FIT REVIEW (DARK NAVY #0c2044)                        -->
  <!-- ========================================================================= -->
  <section class="photo-fit-module">
    <div class="wrap">
      <div class="photo-fit-card">
        <div class="photo-fit-intro">
          <span class="eyebrow-accent">ZERO-COST SPACE PLANNING</span>
          <h2 class="photo-fit-title">Before you order, verify your room fit.</h2>
          <p class="photo-fit-lead">
            Avoid the common mistakes facilities make: ordering equipment that doesn't match the ceiling height, wall backing, electrical layout, or patient movement zones.
          </p>
        </div>

        <div class="photo-steps-grid">
          <div class="step-card">
            <div class="step-circle">1</div>
            <h4 class="step-title">Tell Us About Your Setting</h4>
            <p class="step-desc">Share your clinical or athletic goals, patient population, and weekly volume.</p>
          </div>
          <div class="step-card">
            <div class="step-circle">2</div>
            <h4 class="step-title">Send A Photo Of Your Space</h4>
            <p class="step-desc">Snap 1–2 photos of your intended therapy wall, ceiling clearance, and floor perimeter.</p>
          </div>
          <div class="step-card">
            <div class="step-circle">3</div>
            <h4 class="step-title">Get Practical Fit Guidance</h4>
            <p class="step-desc">Receive a personalized space clearance assessment and equipment recommendation in 24–48 hours.</p>
          </div>
        </div>

        <div class="photo-fit-action text-center">
          <a class="photo-fit-cta" href="/photo-fit-review/">
            Request a Free Photo Fit Review &rarr;
          </a>
          <p class="photo-fit-note">100% Free &bull; No obligation &bull; Turnaround within 24–48 hours</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 6: THE EVIDENCE GUARDRAIL (CRISP WHITE #FFFFFF)                    -->
  <!-- ========================================================================= -->
  <section class="evidence-module">
    <div class="wrap">
      <div class="evidence-inner">
        <div class="evidence-content">
          <span class="section-eyebrow">CLINICAL INTEGRITY &amp; ETHICS</span>
          <h2 class="section-headline section-headline--dark">
            We tell you what the research shows—including its limits.
          </h2>
          <p class="evidence-copy">
            We review published literature and present the evidence honestly. We will not tell you this equipment prevents falls, treats Parkinson's, or guarantees outcomes. If a claim isn't supported, we'll say so.
          </p>
          <p class="evidence-copy">
            Dual-task training is supported by substantial academic research for targeting neuroplasticity, cognitive-motor interference, and postural control. But commercial equipment does not replace clinical judgment, individualized care plans, or skilled provider oversight.
          </p>
          <div class="evidence-cta-row">
            <a class="evidence-link-btn" href="/how-it-works/">
              Read Our Evidence Library &rarr;
            </a>
            <a class="evidence-phone-link" href="tel:18004317788">
              Questions? Call Equipment Advisor: <strong>1-800-431-7788</strong>
            </a>
          </div>
        </div>

        <div class="evidence-card">
          <h4 class="evidence-card-title">CMT Evidence Principles</h4>
          <ul class="evidence-checklist">
            <li>
              <span class="check-green">✓</span>
              <span><strong>Separation of Claims:</strong> Academic dual-task science is never conflated with manufacturer marketing.</span>
            </li>
            <li>
              <span class="check-green">✓</span>
              <span><strong>No Clinical Guarantees:</strong> No promises of disease reversal, fall elimination, or cure.</span>
            </li>
            <li>
              <span class="check-green">✓</span>
              <span><strong>CPT Billing Context:</strong> Codes 97530/97112 refer to skilled therapeutic activities billed under licensed provider discretion.</span>
            </li>
            <li>
              <span class="check-green">✓</span>
              <span><strong>The Concession Rule:</strong> Every head-to-head comparison honestly notes where competitors excel.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* GLOBAL TOKENS & HELPERS */
  .text-center { text-align: center; }
  .section-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #FF6500;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .section-headline {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .section-headline--dark {
    color: #0c2044;
  }
  .section-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 44rem;
    margin: 0 auto;
  }
  .section-lead--dark {
    color: #475569;
  }

  /* MODULE 1: HERO */
  .hero-module {
    position: relative;
    padding: 5rem 0 5.5rem;
    background: radial-gradient(circle at 60% 30%, #152c5b 0%, #0c2044 65%, #060B19 100%);
    color: #FFFFFF;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero-container {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3.5rem;
    align-items: center;
  }
  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 101, 0, 0.15);
    border: 1px solid rgba(255, 101, 0, 0.4);
    color: #FF6500;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }
  .hero-headline {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    color: #FFFFFF;
    margin: 0 0 1.25rem;
  }
  .hero-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0 0 2.25rem;
    max-width: 36rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta-primary {
    background: #FF6500;
    color: #FFFFFF;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(255, 101, 0, 0.4);
    transition: transform 0.2s, background 0.2s;
  }
  .cta-primary:hover {
    background: #FF7A1A;
    transform: translateY(-2px);
  }
  .cta-secondary {
    background: transparent;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* HERO HUD */
  .hud-card {
    background: rgba(10, 17, 40, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
  }
  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .hud-badge-audited {
    font-size: 0.72rem;
    font-weight: 700;
    color: #00D2FF;
    letter-spacing: 0.05em;
  }
  .hud-live-tag {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  .hud-image-box {
    text-align: center;
    padding: 1rem 0;
  }
  .hardware-render {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.6));
  }
  .hud-score-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  .score-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
  }
  .score-title {
    display: block;
    font-size: 0.7rem;
    color: #94A3B8;
    text-transform: uppercase;
  }
  .score-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
  }
  .score-accent { color: #FF6500; }

  /* MODULE 2: TRUST STRIP */
