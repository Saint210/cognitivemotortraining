---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuroMesh from '../components/NeuroMesh.astro';
import { Image } from 'astro:assets';
import miniProduct from '../assets/images/Mini-Low-Impact-45.png';

const trustMetrics = [
  { value: '900+', label: 'Commercial Deployments', sub: 'Hospitals, clinics & performance centers' },
  { value: '20+', label: 'Countries Worldwide', sub: 'Standardized international protocols' },
  { value: '13,000+', label: 'Patient & Athlete Profiles', sub: 'Tracked across SMARTfit Neuro-Cloud' },
  { value: '400,000+', label: 'Sessions Completed', sub: 'Objective motor-cognitive data recorded' },
];

const personas = [
  { id: 'rehab', label: 'Physical Therapy & Neuro-Rehab', link: '/applications/rehabilitation/' },
  { id: 'senior', label: 'Senior Living & Fall Prevention', link: '/applications/healthy-aging/' },
  { id: 'sports', label: 'Athletics & Sports Performance', link: '/applications/sports-performance/' },
  { id: 'tactical', label: 'Tactical Readiness & Defense', link: '/applications/tactical/' },
  { id: 'education', label: 'K-12 Physical Ed & Special Ed', link: '/applications/education/' },
];

const continuumStages = [
  {
    stage: '01',
    title: 'Youth & Education',
    subtitle: 'Pediatric Development & Active Learning',
    desc: 'Pediatric neuro-development, ADHD focus training, active learning, and sensorimotor coordination in schools.',
    target: 'K-12 Students & Special Education',
    system: 'SMARTfit Mini Low-Impact',
  },
  {
    stage: '02',
    title: 'Sports Performance',
    subtitle: 'Reaction Agility & Decision Speed',
    desc: 'Multi-directional reaction agility under fatigue, peripheral target tracking, and return-to-play assessment.',
    target: 'Collegiate, Pro & Elite Athletes',
    system: 'ProTrainer & Wireless Strike Pods',
  },
  {
    stage: '03',
    title: 'Clinical Rehabilitation',
    subtitle: 'Post-Stroke, TBI & Neuroplastic Remapping',
    desc: 'Post-stroke motor recovery, Parkinson’s motor remapping, traumatic brain injury (TBI) therapy, and objective skilled documentation.',
    target: 'Outpatient PT, OT & Hospital Networks',
    system: 'SMARTfit Mini on Mobile Rolling Kiosk',
    featured: true,
  },
  {
    stage: '04',
    title: 'Fall Prevention',
    subtitle: 'Dual-Task Gait & Center of Gravity',
    desc: 'Dual-task gait retraining, dynamic center-of-gravity stabilization, functional reach, and balance confidence.',
    target: 'Older Adults & Fall-Risk Patients',
    system: 'SMARTfit Mini + Balance Platforms',
  },
  {
    stage: '05',
    title: 'Active Aging & Memory Care',
    subtitle: 'Cognitive Longevity & Social Engagement',
    desc: 'Cognitive longevity programming, executive function maintenance, social group engagement, and independent living mobility.',
    target: 'Senior Living & Memory Care Communities',
    system: 'SMARTfit Mini or MultiTrainer',
  },
  {
    stage: '06',
    title: 'Tactical Readiness',
    subtitle: 'Decision-Making Under Physical Load',
    desc: 'High-stress situational awareness, target discrimination under physical fatigue, and first-responder motor-cognitive conditioning.',
    target: 'Military, Police & Fire Training Facilities',
    system: 'ProTrainer High-Impact System',
  },
];

const cognitivePillars = [
  { title: 'Working Memory', desc: 'Retaining multi-step clinical or athletic sequences while in continuous functional movement.' },
  { title: 'Inhibitory Control', desc: 'Suppressing incorrect motor impulses when presented with sudden conflicting visual distractor cues.' },
  { title: 'Cognitive Flexibility', desc: 'Rapidly switching physical motor strategies as task rules dynamically alter mid-drill.' },
  { title: 'Processing Speed', desc: 'Measuring visual stimulus recognition and neuromuscular transmission down to milliseconds.' },
  { title: 'Sustained Attention', desc: 'Maintaining high focus, reaction accuracy, and target precision through physical fatigue.' },
  { title: 'Decision Making', desc: 'Selecting and executing the optimal physical response under strict time constraints.' },
  { title: 'Spatial Orientation', desc: 'Tracking peripheral targets and spatial awareness across an expansive 180° visual field.' },
  { title: 'Sensorimotor Coordination', desc: 'Translating visual-cognitive computations into accurate physical strikes.' },
];
---

<BaseLayout 
  title="Cognitive Motor Training Systems"
  description="CMT Systems is the authoritative B2B partner for SMARTfit dual-task cognitive-motor systems. Evidence-based training for rehabilitation, senior living, and athletics."
>
  <!-- ========================================================================= -->
  <!-- MODULE 01 & 02: HERO SECTION (DARK COMMAND-CENTER)                        -->
  <!-- ========================================================================= -->
  <section class="hero-section">
    <NeuroMesh />
    
    <div class="wrap hero-container">
      <div class="hero-content">
        <div class="eyebrow-pill">
          <span class="pill-spark">⚡</span>
          <span>ADVANCED DUAL-TASK NEURO-MOTOR TECHNOLOGY</span>
        </div>
        
        <h1 class="hero-headline">
          Brain Health Is The <span class="text-gradient">Next Frontier</span> Of Human Performance.
        </h1>
        
        <p class="hero-lead">
          Evidence-based cognitive-motor training protocols that simultaneously engage cognitive processing, 
          reactive agility, dynamic balance, and functional movement across clinical, athletic, and healthy aging populations.
        </p>

        <div class="hero-checkmarks">
          <div class="check-item">
            <span class="check-icon">✓</span>
            <span>Peer-Reviewed Evidence</span>
          </div>
          <div class="check-item">
            <span class="check-icon">✓</span>
            <span>Objective DTC Measurement</span>
          </div>
          <div class="check-item">
            <span class="check-icon">✓</span>
            <span>High-Impact Commercial Build</span>
          </div>
        </div>

        <div class="hero-cta-group">
          <a class="cta-primary" href="/request-demo/">
            Request Institutional Quote &rarr;
          </a>
          <a class="cta-secondary" href="/texas-in-services/">
            <span class="play-icon">▶</span>
            Schedule Texas On-Site Demo
          </a>
        </div>

        <!-- PERSONA ROUTING CHIPS -->
        <div class="persona-selector">
          <p class="persona-prompt">SELECT YOUR FACILITY SETTING FOR TAILORED SPECIFICATIONS:</p>
          <div class="persona-chips">
            {personas.map((p) => (
              <a class="persona-chip" href={p.link}>{p.label}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- HERO VISUAL: 3D HARDWARE + COMMAND HUD -->
      <div class="hero-visual">
        <div class="hud-card">
          <div class="hud-header">
            <div class="hud-status">
              <span class="live-dot"></span>
              <span>SMARTFIT NEURO-CLOUD 4.0</span>
            </div>
            <span class="hud-badge">CLINICAL DUAL-TASK HUD</span>
          </div>

          <div class="hud-preview-image">
            <Image 
              src={miniProduct}
              alt="SMARTfit Mini Single-Station Cognitive-Motor Kiosk"
              width={400}
              height={400}
              format="webp"
              class="hardware-render"
            />
            <div class="render-caption">
              <span class="caption-title">SMARTfit Mini Single-Station</span>
              <span class="caption-spec">Mobile Rolling Kiosk &bull; 9 Target Strike Face</span>
            </div>
          </div>

          <div class="hud-telemetry">
            <div class="telemetry-box">
              <span class="tel-label">Dual-Task Cost (DTC)</span>
              <span class="tel-value tel-cyan">-18.4%</span>
              <span class="tel-sub">Objective Cognitive Cost</span>
            </div>
            <div class="telemetry-box">
              <span class="tel-label">Reaction Latency</span>
              <span class="tel-value tel-green">214 ms</span>
              <span class="tel-sub">Sensory Neuromuscular Transmission</span>
            </div>
            <div class="telemetry-box">
              <span class="tel-label">Neuroplastic Stimulus</span>
              <span class="tel-value tel-orange">Active</span>
              <span class="tel-sub">Prefrontal Cortex Remapping</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 03: TRUST & DEPLOYMENT METRICS (CRISP LIGHT SLATE)                 -->
  <!-- ========================================================================= -->
  <section class="trust-strip">
    <div class="wrap">
      <div class="metrics-grid">
        {trustMetrics.map((m) => (
          <div class="metric-card">
            <span class="metric-num">{m.value}</span>
            <span class="metric-label">{m.label}</span>
            <span class="metric-sub">{m.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 04: THE PARADIGM SHIFT (LUMINOUS WHITE & CRISP CONTRAST)           -->
  <!-- ========================================================================= -->
  <section class="contrast-section">
    <div class="wrap">
      <div class="section-header text-center">
        <span class="section-eyebrow">THE SENSORIMOTOR DEFICIT</span>
        <h2 class="section-headline section-headline--dark">Traditional Training Misses Half The Equation.</h2>
        <p class="section-lead section-lead--dark">
          Physical rehabilitation trains the body in isolation. Brain games train the mind on a screen. 
          Real-world functional independence and athletic performance require both systems to communicate under millisecond time constraints.
        </p>
      </div>

      <div class="contrast-grid">
        <!-- TRADITIONAL CARD (LIGHT CRISP SLATE) -->
        <div class="contrast-card contrast-card--traditional">
          <div class="card-badge card-badge--muted">TRADITIONAL PHYSICAL TRAINING</div>
          <h3 class="card-title card-title--dark">Isolated Motor Execution</h3>
          <ul class="contrast-list">
            <li>
              <span class="icon-bad">✕</span>
              <div>
                <strong>Isolated Motor Output:</strong> Repetitive physical exercise without cognitive demand fails to prepare the patient for real-world environmental distractions.
              </div>
            </li>
            <li>
              <span class="icon-bad">✕</span>
              <div>
                <strong>Subjective Progress Notes:</strong> Reliance on visual observation leaves skilled therapy documentation vulnerable to payer scrutiny and denials.
              </div>
            </li>
            <li>
              <span class="icon-bad">✕</span>
              <div>
                <strong>Static Neurological Stimulus:</strong> Fails to trigger the heightened neuroplastic adaptations produced by combined aerobic and cognitive exertion.
              </div>
            </li>
            <li>
              <span class="icon-bad">✕</span>
              <div>
                <strong>High Therapy Dropout:</strong> Repetitive, monotonous rehabilitation exercises lead to low patient adherence and compliance.
              </div>
            </li>
          </ul>
        </div>

        <!-- CMT DUAL-TASK CARD (RICH NAVY POWER CARD) -->
        <div class="contrast-card contrast-card--cmt">
          <div class="card-badge card-badge--accent">CMT COGNITIVE-MOTOR INTEGRATION</div>
          <h3 class="card-title card-title--light">Simultaneous Dual-Task Training</h3>
          <ul class="contrast-list contrast-list--light">
            <li>
              <span class="icon-good">✓</span>
              <div>
                <strong>Simultaneous Sensorimotor Processing:</strong> Forces the prefrontal cortex and motor cortex to process visual stimuli while executing dynamic physical movement.
              </div>
            </li>
            <li>
              <span class="icon-good">✓</span>
              <div>
                <strong>Objective Dual-Task Cost (DTC):</strong> Automatically quantifies the exact percentage of performance loss when moving under cognitive load.
              </div>
            </li>
            <li>
              <span class="icon-good">✓</span>
              <div>
                <strong>Standardized Clinical Protocols:</strong> Generates objective data supporting therapeutic activity documentation (CPT 97530 & 97112 skilled care plans).
              </div>
            </li>
            <li>
              <span class="icon-good">✓</span>
              <div>
                <strong>92%+ Patient Adherence:</strong> Over 3,000 gamified, interactive visual-audio target activities keep patients and athletes deeply engaged.
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 05: FOUNDATIONAL SCIENCE (AIRY LIGHT SLATE)                        -->
  <!-- ========================================================================= -->
  <section class="explainer-section">
    <div class="wrap explainer-grid">
      <div class="explainer-text">
        <span class="section-eyebrow">NEUROLOGICAL MECHANISMS</span>
        <h2 class="section-headline section-headline--dark">What Is Cognitive-Motor Training?</h2>
        <p class="explainer-p">
          Cognitive-Motor Training (CMT) is the simultaneous integration of physical exercise and cognitive tasks designed to stimulate neuroplasticity. 
          Unlike sequential training (exercising first, then playing a brain game), CMT forces the central nervous system to allocate neural resources between balance, movement, working memory, and decision-making simultaneously.
        </p>
        
        <div class="benefit-box">
          <div class="benefit-item">
            <span class="benefit-num">01</span>
            <div>
              <strong>Neuroplastic Remapping:</strong> Accelerates neural pathway recruitment following stroke, traumatic brain injury (TBI), or neurological decline.
            </div>
          </div>
          <div class="benefit-item">
            <span class="benefit-num">02</span>
            <div>
              <strong>Functional Transfer:</strong> Reduces cognitive distraction during walking—the leading hidden cause of senior falls and athletic non-contact injuries.
            </div>
          </div>
        </div>

        <a class="learn-more-link" href="/how-it-works/">
          Explore The Published Dual-Task Science &rarr;
        </a>
      </div>

      <!-- VENN DIAGRAM VISUAL COMPONENT -->
      <div class="venn-wrapper">
        <div class="venn-card">
          <h4 class="venn-header">THE COGNITIVE-MOTOR INTEGRATION ENGINE</h4>
          <div class="venn-graphic">
            <div class="venn-circle venn-circle--cog">
              <span class="venn-tag">COGNITIVE LOAD</span>
              <span class="venn-item">&bull; Working Memory</span>
              <span class="venn-item">&bull; Executive Function</span>
              <span class="venn-item">&bull; Decision Speed</span>
            </div>
            
            <div class="venn-core">
              <span class="core-glow"></span>
              <span class="core-title">CMT CORE</span>
              <span class="core-desc">Dual-Task Neuroplastic Stimulus</span>
            </div>

            <div class="venn-circle venn-circle--mot">
              <span class="venn-tag">MOTOR ACTION</span>
              <span class="venn-item">&bull; Dynamic Balance</span>
              <span class="venn-item">&bull; Agility &amp; Gait</span>
              <span class="venn-item">&bull; Reaction Strikes</span>
            </div>
          </div>
          <p class="venn-footer-note">
            Standardized via SMARTfit Neuro-Cloud algorithms &bull; Standardized TUG-Cognitive protocol
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 06: THE BRAIN HEALTH CONTINUUM (NAVY THEATER CONTAINER)            -->
  <!-- ========================================================================= -->
  <section class="continuum-section">
    <div class="wrap">
      <div class="section-header text-center">
        <span class="section-eyebrow">POPULATION-SPECIFIC PROTOCOLS</span>
        <h2 class="section-headline">The Brain Health Continuum</h2>
        <p class="section-lead">
          Standardized hardware and software protocols engineered for clinical rehabilitation, senior independence, athletic performance, and tactical defense.
        </p>
      </div>

      <div class="continuum-grid">
        {continuumStages.map((st) => (
          <div class={`continuum-card ${st.featured ? 'continuum-card--featured' : ''}`}>
            <div class="card-stage-row">
              <span class="stage-tag">STAGE {st.stage}</span>
              {st.featured && <span class="featured-badge">FEATURED HUB</span>}
            </div>
            <h3 class="st-title">{st.title}</h3>
            <span class="st-sub">{st.subtitle}</span>
            <p class="st-desc">{st.desc}</p>
            <div class="st-meta">
              <p><strong>Target:</strong> {st.target}</p>
              <p><strong>Primary System:</strong> {st.system}</p>
            </div>
            <a class="st-link" href="/applications/">
              View Application Details &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 07: HARDWARE & SYSTEMS SUITE (CRISP WHITE STUDIO CARDS)            -->
  <!-- ========================================================================= -->
  <section class="hardware-section">
    <div class="wrap">
      <div class="section-header text-center">
        <span class="section-eyebrow">COMMERCIAL-GRADE SPECIFICATIONS</span>
        <h2 class="section-headline section-headline--dark">Engineered For High-Impact Institutional Environments</h2>
        <p class="section-lead section-lead--dark">
          Modular physical strike panels, wireless portable pods, and cloud-connected clinical controllers built for high-volume facilities.
        </p>
      </div>

      <div class="hardware-grid">
        <!-- SYSTEM 1: MINI -->
        <div class="hw-card">
          <div class="hw-image-wrap">
            <Image 
              src={miniProduct}
              alt="SMARTfit Mini Single-Station"
              width={400}
              height={400}
              format="webp"
            />
          </div>
          <div class="hw-body">
            <span class="hw-category">SINGLE-STATION KIOSK</span>
            <h3 class="hw-title">SMARTfit Mini System</h3>
            <p class="hw-desc">
              The flagship single-station platform for clinics and wellness centers. Features a 46" x 46" impact face with 9 multi-symbol target zones.
            </p>
            <ul class="hw-specs">
              <li><strong>Mounting:</strong> Mobile rolling stand or direct on-wall track</li>
              <li><strong>Impact Levels:</strong> Low-Impact (Hands/Balls) &amp; High-Impact</li>
              <li><strong>Accessibility:</strong> ADA compliant, wheelchair accessible, motorized height adjust</li>
              <li><strong>Best For:</strong> Outpatient physical therapy, OT, senior living wellness</li>
            </ul>
            <div class="hw-action">
              <a class="btn-hw" href="/systems/mini/">View Mini Specifications &rarr;</a>
            </div>
          </div>
        </div>

        <!-- SYSTEM 2: PROTRAINER -->
        <div class="hw-card">
          <div class="hw-image-wrap">
            <img src="/images/products/protrainer-2.jpg" alt="SMARTfit ProTrainer Multi-Station System" />
          </div>
          <div class="hw-body">
            <span class="hw-category">MULTI-STATION SYSTEM</span>
            <h3 class="hw-title">SMARTfit ProTrainer</h3>
            <p class="hw-desc">
              Modular 2, 3, or 4-station systems designed for high-volume hospitals, sports performance complexes, and tactical gymnasiums.
            </p>
            <ul class="hw-specs">
              <li><strong>Configuration:</strong> 2 to 4 synchronized stations on wall or frame</li>
              <li><strong>Target Nodes:</strong> Up to 36 independently responsive strike zones</li>
              <li><strong>Multi-User:</strong> Train multiple patients or athletes simultaneously</li>
              <li><strong>Best For:</strong> Inpatient rehabilitation, collegiate athletics, defense readiness</li>
            </ul>
            <div class="hw-action">
              <a class="btn-hw" href="/systems/protrainer/">View ProTrainer Configurations &rarr;</a>
            </div>
          </div>
        </div>

        <!-- SYSTEM 3: STRIKE PODS -->
        <div class="hw-card">
          <div class="hw-image-wrap">
            <img src="/images/products/smartfit-strikepods.png" alt="SMARTfit Wireless Strike Pods" />
          </div>
          <div class="hw-body">
            <span class="hw-category">PORTABLE WIRELESS ECOSYSTEM</span>
            <h3 class="hw-title">Wireless Strike Pods</h3>
            <p class="hw-desc">
              Ultra-portable, battery-powered multi-modal strike targets connecting wirelessly up to 100 meters for 360° ambulatory training.
            </p>
            <ul class="hw-specs">
              <li><strong>Kits Available:</strong> Bundles of 3, 5, 7, or 9 wireless pods</li>
              <li><strong>Connectivity:</strong> Ultra-low latency mesh with central tablet controller</li>
              <li><strong>Mounting:</strong> Floor pods, magnetic wall mounts, or adjustable stands</li>
              <li><strong>Best For:</strong> Hallway gait assessment, athletic agility turf, mobile therapists</li>
            </ul>
            <div class="hw-action">
              <a class="btn-hw" href="/systems/strike-pods/">View Strike Pods Kits &rarr;</a>
            </div>
          </div>
        </div>
      </div>
      
      <p class="hardware-disclaimer">
        * All systems include commercial warranty, cloud software licensing, and optional professional installation. Exact quotations provided upon consultation.
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 08: THE SCIENCE & DUAL-TASK COST (LIGHT SLATE WITH NAVY HUD)       -->
  <!-- ========================================================================= -->
  <section class="science-section">
    <div class="wrap">
      <div class="science-card">
        <div class="science-text">
          <span class="section-eyebrow">OBJECTIVE SENSORIMOTOR METRICS</span>
          <h2 class="science-headline">Dual-Task Cost (DTC) Quantified.</h2>
          <p class="science-lead">
            When asked to walk while performing a cognitive calculation, gait speed slows and balance wavers. 
            This performance drop is clinically defined as <strong>Dual-Task Cost (DTC)</strong>—the most sensitive predictive indicator of fall risk, concussion recovery, and neurological decline.
          </p>
          <div class="science-bullet">
            <strong>Standardized Assessment Protocol:</strong> 
            Compatible with the Timed Up and Go (TUG) Cognitive assessment battery. Quantifies milliseconds and error rates automatically.
          </div>
        </div>

        <!-- DTC CHART COMPONENT -->
        <div class="dtc-chart-card">
          <div class="chart-header">
            <span>DUAL-TASK GAIT DEGRADATION ANALYSIS</span>
            <span class="live-pill">CLINICAL BENCHMARK</span>
          </div>

          <div class="chart-bars">
            <div class="bar-group">
              <div class="bar-label-row">
                <span>Single-Task Baseline (Normal Gait Speed)</span>
                <span class="bar-val">100% Efficiency</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill bar-fill--base" style="width: 100%;"></div>
              </div>
            </div>

            <div class="bar-group">
              <div class="bar-label-row">
                <span>Traditional Multitask Gait (Untrained Dual-Task)</span>
                <span class="bar-val bar-val--danger">-28.4% DTC (High Fall/Injury Risk)</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill bar-fill--danger" style="width: 71.6%;"></div>
              </div>
            </div>

            <div class="bar-group">
              <div class="bar-label-row">
                <span>Post-CMT Dual-Task Protocol (Trained Neuro-Motor)</span>
                <span class="bar-val bar-val--success">-7.8% DTC (Optimized Dual-Tasking)</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill bar-fill--success" style="width: 92.2%;"></div>
              </div>
            </div>
          </div>

          <p class="chart-footnote">
            Data visualization illustrative of standardized dual-task gait cost recovery documented in peer-reviewed motor-cognitive trials.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 09: EXECUTIVE FUNCTION 8-GRID (CRISP LUMINOUS WHITE)               -->
  <!-- ========================================================================= -->
  <section class="pillars-section">
    <div class="wrap">
      <div class="section-header text-center">
        <span class="section-eyebrow">COGNITIVE ARCHITECTURE</span>
        <h2 class="section-headline section-headline--dark">Targeting The 8 Core Cognitive Pillars</h2>
        <p class="section-lead section-lead--dark">
          CMT software protocols engage the specific executive function domains responsible for motor coordination, reaction speed, and functional independence.
        </p>
      </div>

      <div class="pillars-grid">
        {cognitivePillars.map((p, idx) => (
          <div class="pillar-card">
            <span class="pillar-num">0{idx + 1}</span>
            <h4 class="pillar-title">{p.title}</h4>
            <p class="pillar-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MODULE 10: COMPARISON TABLE (CRISP WHITE WITH ACCENT COLUMN)              -->
  <!-- ========================================================================= -->
  <section class="compare-section">
    <div class="wrap">
      <div class="section-header text-center">
        <span class="section-eyebrow">INSTITUTIONAL BENCHMARK</span>
        <h2 class="section-headline section-headline--dark">Why Clinical &amp; Athletic Leaders Choose SMARTfit</h2>
        <p class="section-lead section-lead--dark">
          Evaluating the critical technological difference between commercial cognitive-motor systems and consumer light gadgets.
        </p>
      </div>

      <div class="table-container">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th class="col-feature">Capability / Benchmark</th>
              <th class="col-smartfit">
                <div class="th-smartfit">
                  <span class="th-brand">SMARTfit CMT Systems</span>
                  <span class="th-sub">Clinical-Grade Dual-Task</span>
                </div>
              </th>
              <th class="col-other">Consumer Light Pods (e.g. BlazePod)</th>
              <th class="col-other">Static Visual Boards (e.g. Dynavision D2)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cell-feature">High-Impact Strike Surface</td>
              <td class="cell-smartfit"><span class="check-yes">✓ YES</span> (Heavy balls, bats, fists)</td>
              <td class="cell-other">No (Light touch only)</td>
