---
import BaseLayout from '../../layouts/BaseLayout.astro';

const audits = [
  {
    name: 'SMARTfit® Dual-Task Systems',
    tagline: 'High-Impact Multi-User Dual-Task Training System',
    category: 'Full-Body Dual-Task System',
    operationalTier: 'Tier 1 — High-Impact Gross Kinetic / 10+ Multi-User',
    evidenceGrade: 'C',
    evidenceLabel: 'Emerging Evidence',
    evidenceSummary: 'Independent device-specific RCTs are limited. Clinical support draws from broad dual-task neuroscience literature. Manufacturer outcome claims require independent verification.',
    regulatoryStatus: 'Commercial Exercise & Assessment Equipment (Not FDA-Cleared)',
    gameCount: 19,
    status: 'Top Recommendation',
    highlight: true,
    image: '/images/products/smartfit-protrainer-high-impact-wall-mount.jpg',
    imageAlt: 'SMARTfit ProTrainer multi-station cognitive-motor training wall system',
    dimensions: {
      cognitive: 5,
      stimulus: 5,
      response: 5,
      physical: 5,
      data: 4,
    },
    pros: [
      'Accommodates high-impact strikes with hands, feet, medicine balls, and sport implements',
      'Extensive executive-function library (Stroop, Flanker, Working Memory, Math, N-Back)',
      'Sub-millisecond Dual-Task Cost (DTC) baseline testing and EMR export',
      'Multi-user capability (up to 10+ participants simultaneously on one system)',
    ],
    cons: [
      'Requires dedicated wall space (wall-mounted) or floor footprint (portable base)',
      'Institutional capital expenditure requiring planned facility budgeting',
    ],
    bestFit: 'Physical therapy, neuro-rehab, sports performance, and senior living facilities requiring whole-body kinetic training.',
    concession: 'For facilities strictly needing FDA-cleared visual field diagnostic testing for driving safety without kinetic demands, Dynavision D2 offers established 510(k) protocols.',
    compareLink: '/compare/',
  },
  {
    name: 'Dynavision D2',
    tagline: 'Light-Array Visuomotor Diagnostic & Rehabilitation Board',
    category: 'Visuomotor Diagnostic Board',
    operationalTier: 'Tier 3 — Upper-Body Reach / Single User',
    evidenceGrade: 'C',
    evidenceLabel: 'Emerging Evidence',
    evidenceSummary: 'Decades of clinical practice in vision therapy and driver rehabilitation, primarily supported by small, uncontrolled studies and observational evidence.',
    regulatoryStatus: 'FDA 510(k) Cleared — Visuomotor Diagnostic & Rehabilitation',
    gameCount: null,
    status: 'Specialized Evaluated System',
    highlight: false,
    image: '/images/competitors/dynavision-d2-light-board.png',
    imageAlt: 'Dynavision D2 light-array visuomotor board with concentric rings of LED push buttons',
    dimensions: {
      cognitive: 3,
      stimulus: 3,
      response: 2,
      physical: 2,
      data: 4,
    },
    pros: [
      'FDA 510(k) clearance for visuomotor diagnostic screening and vision therapy',
      'Established clinical protocols for driver rehabilitation and visual field deficit assessment',
      'Motorized height adjustment for seated wheelchair or standing patients',
    ],
    cons: [
      'Limited kinetic movement (upper-extremity reaching and tapping only)',
      'Light button stimuli only; lacks alphanumeric, Stroop, or working memory task depth',
      '1 user at a time capacity limits group throughput and billable efficiency',
    ],
    bestFit: 'Driver rehabilitation specialists and neuro-optometric vision therapy clinics.',
    concession: 'Dynavision holds FDA clearance with decades of driver return-to-readiness normative data that commercial exercise systems do not possess.',
    compareLink: '/compare/',
  },
  {
    name: 'Dividat Senso',
    tagline: 'Force-Plate Stepping Exergame for Fall Prevention',
    category: 'Stepping Balance Plate',
    operationalTier: 'Tier 3 — Lower-Body Stepping / Single User',
    evidenceGrade: 'B',
    evidenceLabel: 'Moderate Evidence',
    evidenceSummary: 'Multiple Swiss and European RCTs support dual-task stepping for older adult fall prevention, stroke, and Parkinson\'s disease rehabilitation. Strongest independent evidence in this comparison set.',
    regulatoryStatus: 'CE Medical Device — Class IIa (European Union)',
    gameCount: null,
    status: 'Specialized Evaluated System',
    highlight: false,
    image: '/images/competitors/dividat-senso-stepping-platform.jpg',
    imageAlt: 'Dividat Senso stepping balance plate with integrated force sensors and front visual display',
    dimensions: {
      cognitive: 3,
      stimulus: 3,
      response: 3,
      physical: 3,
      data: 4,
    },
    pros: [
      'Calibrated 20-sensor force-plate detects subtle center-of-pressure and step latency',
      'Strong Swiss academic research supporting dual-task step training in older adults',
      'Support handrail provides psychological safety for frail geriatric patients',
    ],
    cons: [
      'Restricted to lower-body stepping on a single floor plate; no upper-body kinetic training',
      '1 participant at a time; low throughput for senior community wellness centers',
      'Screen-based display can induce passive focus without athletic engagement',
    ],
    bestFit: 'Geriatric physical therapy practices and research labs focused strictly on lower-extremity step-reaction time.',
    concession: 'Dividat Senso provides calibrated force-plate stepping data with dedicated Swiss research specifically validated for older adult fall-risk screening.',
    compareLink: '/compare/',
  },
  {
    name: 'Bioness BITS®',
    tagline: 'Standardized Touchscreen Neuro-Occupational Therapy Board',
    category: 'Touchscreen Therapy Board',
    operationalTier: 'Tier 4 — Zero-Impact Seated / Single User',
    evidenceGrade: 'B',
    evidenceLabel: 'Moderate Evidence',
    evidenceSummary: 'Clinical studies support use in concussion management, TBI, stroke, and balance rehabilitation. Some industry-funded research; independent replication ongoing.',
    regulatoryStatus: 'FDA Class II Medical Device — CE Marked',
    gameCount: null,
    status: 'Specialized Evaluated System',
    highlight: false,
    image: '/images/competitors/bioness-bits-touchscreen.jpg',
    imageAlt: 'Bioness BITS touchscreen therapy system mounted on an adjustable mobile clinical stand',
    dimensions: {
      cognitive: 4,
      stimulus: 4,
      response: 2,
      physical: 1,
      data: 4,
    },
    pros: [
      'Standardized occupational therapy evaluation batteries (Bells test, Trail Making, visual search)',
      'Class I medical device status with hospital-wide safety compliance',
      'Excellent for acute inpatient neuro-rehab where patients cannot stand or bear impact',
    ],
    cons: [
      'Delicate touchscreen interface; cannot absorb athletic balls or high-velocity impact',
      'Virtually zero cardiovascular or whole-body gross-motor training demand',
      'High institutional software licensing and maintenance costs',
    ],
    bestFit: 'Inpatient hospital neuro-OT departments treating acute stroke and traumatic brain injury patients.',
    concession: 'BITS excels at acute-stage seated OT assessments and standardized bedside neuro-evaluations where full-body movement is clinically contraindicated.',
    compareLink: '/compare/',
  },
];
---

<BaseLayout
  title="Independent Cognitive-Motor Technology Audits"
  description="Independent clinical technology audits for cognitive-motor training systems including SMARTfit, Dynavision D2, Dividat Senso, and Bioness BITS. Objective 5-Dimension operational evaluation with academic evidence grading."
>
  <!-- HERO (BRIGHT, AIRY, INSTITUTIONAL) -->
  <section class="audits-hero">
    <div class="wrap">
      <div class="hero-badge">INDEPENDENT CLINICAL TECHNOLOGY AUDITS · 2026 EDITION</div>
      <h1 class="hero-title">Objective Equipment Audits: What the Spec Sheets Don't Tell You</h1>
      <p class="hero-lead">
        We evaluate the leading cognitive-motor systems using hands-on teardown data from certified installers. We grade real hardware impact durability, executive-function depth, EMR compatibility, and facility footprint requirements.
      </p>
      <div class="hero-actions">
        <a class="cta-button" href="/evaluation-framework/">Explore The 5-Dimension Framework &rarr;</a>
        <a class="cta-secondary" href="/photo-fit-review/">Request A Photo Fit Review &rarr;</a>
      </div>
    </div>
  </section>

  <!-- AUDIT CARDS CONTAINER (CLEAN LIGHT SLATE WITH EXPANSIVE WHITE CARDS) -->
  <section class="audits-list-section">
    <div class="wrap">
      <div class="section-intro text-center">
        <span class="section-badge">VERIFIED EQUIPMENT PROFILES</span>
        <h2 class="section-title">Audited Systems &amp; Performance Scores</h2>
        <p class="section-desc">
          The 5-Dimension pip scores measure operational hardware capabilities only. Each system also carries an independent Academic Evidence Grade (A–D) based on the quality and volume of published peer-reviewed research. These are separate evaluations.
        </p>
      </div>

      <div class="audits-stack">
        {audits.map((item) => (
          <article class={`audit-card ${item.highlight ? 'audit-card--highlight' : ''}`}>
            <div class="card-top-row">
              <div class="card-header-main">
                {item.image && (
                  <div class="audit-hardware-thumb">
                    <img 
                      src={item.image} 
                      alt={item.imageAlt || item.name} 
                      loading="lazy" 
                      width="160" 
                      height="120" 
                      class="hardware-img"
                    />
                  </div>
                )}
                <div class="card-header-left">
                  <div class="pill-row">
                    <span class={`status-pill ${item.highlight ? 'status-pill--rec' : ''}`}>{item.status}</span>
                    <span class="category-pill">{item.category}</span>
                  </div>
                  <h2 class="audit-name">{item.name}</h2>
                  <p class="audit-tagline">{item.tagline}</p>
                </div>
              </div>
              <div class="card-header-score">
                <div class={`evidence-grade grade-${item.evidenceGrade}`}>
                  <span class="grade-letter">{item.evidenceGrade}</span>
                </div>
                <span class="score-label">Evidence Grade</span>
                <span class="grade-sublabel">{item.evidenceLabel}</span>
              </div>
            </div>

            <!-- EVIDENCE & REGULATORY STATUS ROW -->
            <div class="evidence-row">
              <div class="evidence-item">
                <span class="evidence-heading">Regulatory Status</span>
                <span class="evidence-value">{item.regulatoryStatus}</span>
              </div>
              <div class="evidence-item">
                <span class="evidence-heading">Operational Tier</span>
                <span class="evidence-value">{item.operationalTier}</span>
              </div>
              {item.gameCount && (
                <div class="evidence-item">
                  <span class="evidence-heading">Game Library</span>
                  <span class="evidence-value">{item.gameCount} Documented Protocols</span>
                </div>
              )}
              <div class="evidence-item evidence-item--wide">
                <span class="evidence-heading">Evidence Summary</span>
                <span class="evidence-value">{item.evidenceSummary}</span>
              </div>
            </div>

            <!-- DIMENSIONS BREAKDOWN BAR (LIGHT, CRISP, SCANNABLE) -->
            <div class="card-dimensions-bar">
              <div class="dim-stat">
                <span class="dim-label">Cognitive</span>
                <div class="score-pips">
                  {[1, 2, 3, 4, 5].map((pip) => (
                    <span class={`pip ${pip <= item.dimensions.cognitive ? 'pip--active' : ''}`} />
                  ))}
                </div>
              </div>
              <div class="dim-stat">
                <span class="dim-label">Stimulus</span>
                <div class="score-pips">
                  {[1, 2, 3, 4, 5].map((pip) => (
                    <span class={`pip ${pip <= item.dimensions.stimulus ? 'pip--active' : ''}`} />
                  ))}
                </div>
              </div>
              <div class="dim-stat">
                <span class="dim-label">Response</span>
                <div class="score-pips">
                  {[1, 2, 3, 4, 5].map((pip) => (
                    <span class={`pip ${pip <= item.dimensions.response ? 'pip--active' : ''}`} />
                  ))}
                </div>
              </div>
              <div class="dim-stat">
                <span class="dim-label">Physical</span>
                <div class="score-pips">
                  {[1, 2, 3, 4, 5].map((pip) => (
                    <span class={`pip ${pip <= item.dimensions.physical ? 'pip--active' : ''}`} />
                  ))}
                </div>
              </div>
              <div class="dim-stat">
                <span class="dim-label">Data</span>
                <div class="score-pips">
                  {[1, 2, 3, 4, 5].map((pip) => (
                    <span class={`pip ${pip <= item.dimensions.data ? 'pip--active' : ''}`} />
                  ))}
                </div>
              </div>
            </div>

            <!-- AUDIT BODY GRID (PLENTY OF BREATHING ROOM) -->
            <div class="card-body-grid">
              <div class="pros-cons-col">
                <div class="sub-block">
                  <h3 class="block-title text-green">Strengths &amp; Clinical Advantages</h3>
                  <ul class="check-list">
                    {item.pros.map((pro) => (
                      <li>{pro}</li>
                    ))}
                  </ul>
                </div>
                <div class="sub-block">
                  <h3 class="block-title text-orange">Hardware &amp; Operational Boundaries</h3>
                  <ul class="cross-list">
                    {item.cons.map((con) => (
                      <li>{con}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="verdict-col">
                <div class="verdict-block">
                  <h3 class="block-title">Best Clinical &amp; Performance Fit</h3>
                  <p class="verdict-text">{item.bestFit}</p>
                </div>
                <div class="concession-block">
                  <h3 class="block-title-concession">Auditor's Concession</h3>
                  <p class="concession-text">{item.concession}</p>
                </div>
                <div class="card-actions">
                  <a class="cta-secondary text-sm" href="/compare/">Compare Head-to-Head &rarr;</a>
                  <a class="cta-button text-sm" href="/photo-fit-review/">Check Room Fit &rarr;</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <section class="audits-cta-strip">
    <div class="wrap text-center">
      <h2>Not Sure Which Platform Fits Your Facility Footprint?</h2>
      <p class="cta-lead">
        Send us photos of your room dimensions, ceiling height, and clinical goals. We will perform an objective space fit review before you spend a dime.
      </p>
      <a class="cta-button" href="/photo-fit-review/">Request A Free Photo Fit Review &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO (CRISP WHITE, CLEAN, SPACIOUS) */
  .audits-hero {
    padding: 5.5rem 0 4.5rem;
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0284C7;
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 900;
    color: #0c2044;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    max-width: 54rem;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: #475569;
    max-width: 52rem;
    line-height: 1.65;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0c2044;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    background: #F8FAFC;
    border-color: #0c2044;
  }

  /* LIST SECTION (LIGHT SLATE WITH SPACIOUS WHITE CARDS) */
  .audits-list-section {
    padding: 5.5rem 0 7rem;
    background: #F8FAFC;
  }

  .section-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
  }

  .text-center {
    text-align: center;
  }

  .section-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #FF6500;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: #0c2044;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .section-desc {
    font-size: 1.05rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  .audits-stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .audit-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .audit-card:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
  }

  .audit-card--highlight {
    border: 2px solid #FF6500;
    box-shadow: 0 12px 36px rgba(255, 101, 0, 0.09);
    background: #FFFDFB;
  }

  .card-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .card-header-main {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    min-width: 280px;
  }

  .audit-hardware-thumb {
    width: 140px;
    height: 105px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .hardware-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .pill-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .status-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: #F1F5F9;
    color: #475569;
  }

  .status-pill--rec {
    background: #FF6500;
    color: #FFFFFF;
  }

  .category-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748B;
    background: #F1F5F9;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
  }

  .audit-name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: #0c2044;
    margin: 0 0 0.35rem;
    line-height: 1.2;
  }

  .audit-tagline {
    font-size: 1.05rem;
    color: #0284C7;
    font-weight: 600;
    margin: 0;
  }

  .card-header-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 1rem 1.5rem;
    min-width: 130px;
  }

  .score-circle {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .score-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 900;
    color: #FF6500;
    line-height: 1;
  }

  .score-scale {
    font-size: 0.9rem;
    color: #94A3B8;
    font-weight: 700;
  }

  .score-label {
    font-size: 0.7rem;
    color: #64748B;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.4rem;
  }

  /* DIMENSIONS BAR (LIGHT, AIRY, CRISP) */
  .card-dimensions-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1.25rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .dim-stat {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .dim-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .score-pips {
    display: flex;
    gap: 0.35rem;
  }

  .pip {
    width: 20px;
    height: 7px;
    border-radius: 2px;
    background: #E2E8F0;
  }

  .pip--active {
    background: #0284C7;
  }

  .audit-card--highlight .pip--active {
    background: #FF6500;
  }

  /* BODY GRID (LARGE SPACING) */
  .card-body-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
  }

  .sub-block {
    margin-bottom: 2rem;
  }

  .block-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .text-green {
    color: #059669;
  }

  .text-orange {
    color: #D97706;
  }

  .check-list, .cross-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.6;
  }

  .check-list li::before {
    content: "✓ ";
    color: #059669;
    font-weight: 900;
    margin-right: 0.25rem;
  }

  .cross-list li::before {
    content: "— ";
    color: #D97706;
    font-weight: 900;
    margin-right: 0.25rem;
  }

  .verdict-block {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .verdict-text {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.6;
    margin: 0;
  }

  .concession-block {
    background: #F0F9FF;
    border: 1px solid #BAE6FD;
    border-left: 4px solid #0284C7;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .block-title-concession {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0284C7;
    margin: 0 0 0.5rem;
  }

  .concession-text {
    font-size: 0.9rem;
    color: #0369A1;
    font-style: italic;
    line-height: 1.6;
    margin: 0;
  }

  .card-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .text-sm {
    font-size: 0.88rem;
    padding: 0.7rem 1.25rem;
  }

  /* SEPARATE SUB-CATEGORY POD AUDIT SECTION */
  .pod-audit-sub-section {
    padding: 0 0 7rem;
    background: #F8FAFC;
  }

  .sub-audit-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .sub-audit-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .sub-audit-header-main {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
